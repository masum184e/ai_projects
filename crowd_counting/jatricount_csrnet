{"cells":[{"source":"<a href=\"https://www.kaggle.com/code/masum1834e/jatricount-csrnet?scriptVersionId=357890388\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"code","execution_count":1,"id":"9e4347c4","metadata":{"execution":{"iopub.execute_input":"2026-10-13T06:06:33.173887Z","iopub.status.busy":"2026-10-13T06:06:33.173545Z","iopub.status.idle":"2026-10-13T06:06:33.179986Z","shell.execute_reply":"2026-10-13T06:06:33.179367Z"},"papermill":{"duration":0.015105,"end_time":"2026-10-13T06:06:33.181413+00:00","exception":false,"start_time":"2026-10-13T06:06:33.166308+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import os\n","\n","# Tell CUDA/cuBLAS to use a deterministic workspace configuration\n","os.environ[\"CUBLAS_WORKSPACE_CONFIG\"] = \":4096:8\""]},{"cell_type":"code","execution_count":2,"id":"4c551f3d","metadata":{"execution":{"iopub.execute_input":"2026-10-13T06:06:33.192737Z","iopub.status.busy":"2026-10-13T06:06:33.192152Z","iopub.status.idle":"2026-10-13T06:06:46.836905Z","shell.execute_reply":"2026-10-13T06:06:46.836198Z"},"papermill":{"duration":13.651987,"end_time":"2026-10-13T06:06:46.838528+00:00","exception":false,"start_time":"2026-10-13T06:06:33.186541+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Random seed: 42\n"]}],"source":["import torch\n","import random\n","import numpy as np\n","\n","SEED = 42                 # Define a fixed seed value for reproducibility\n","random.seed(SEED)         # Set the seed for Python's random number generator\n","np.random.seed(SEED)      # Set the seed for NumPy's random number generator\n","torch.manual_seed(SEED)   # Set the seed for PyTorch's CPU random number generator\n","\n","if torch.cuda.is_available():\n","    # Set the seed for random numbers generated on all CUDA GPUs\n","    torch.cuda.manual_seed_all(SEED)\n","\n","# Make cuDNN use deterministic algorithms when possible\n","torch.backends.cudnn.deterministic = True\n","\n","# Disable cuDNN's automatic algorithm benchmarking\n","torch.backends.cudnn.benchmark = False\n","\n","# Force PyTorch to use deterministic algorithms where supported\n","# warn_only=True gives a warning instead of stopping if an operation\n","# has no deterministic implementation\n","torch.use_deterministic_algorithms(True, warn_only=True)\n","\n","print(\"Random seed:\", SEED)"]},{"cell_type":"code","execution_count":3,"id":"da7d839f","metadata":{"execution":{"iopub.execute_input":"2026-10-13T06:06:46.851266Z","iopub.status.busy":"2026-10-13T06:06:46.850412Z","iopub.status.idle":"2026-10-13T06:06:46.901307Z","shell.execute_reply":"2026-10-13T06:06:46.900582Z"},"papermill":{"duration":0.058897,"end_time":"2026-10-13T06:06:46.902557+00:00","exception":false,"start_time":"2026-10-13T06:06:46.84366+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["PyTorch version: 2.10.0+cu128\n","CUDA available: True\n","Using device: cuda:0\n","GPU: Tesla T4\n"]}],"source":["import torch\n","\n","print(\"PyTorch version:\", torch.__version__)\n","print(\"CUDA available:\", torch.cuda.is_available())\n","\n","DEVICE = torch.device(\"cuda:0\" if torch.cuda.is_available() else \"cpu\")\n","\n","print(\"Using device:\", DEVICE)\n","\n","if torch.cuda.is_available():\n","    print(\"GPU:\", torch.cuda.get_device_name(0))"]},{"cell_type":"code","execution_count":4,"id":"58e081ef","metadata":{"execution":{"iopub.execute_input":"2026-10-13T06:06:46.914002Z","iopub.status.busy":"2026-10-13T06:06:46.913514Z","iopub.status.idle":"2026-10-13T06:06:48.589105Z","shell.execute_reply":"2026-10-13T06:06:48.588417Z"},"papermill":{"duration":1.683556,"end_time":"2026-10-13T06:06:48.591127+00:00","exception":false,"start_time":"2026-10-13T06:06:46.907571+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torchvision.transforms as T \n","import cv2 \n","from torch.utils.data import Dataset \n","from scipy.io import loadmat \n","from scipy.ndimage import gaussian_filter \n","\n","# Define a custom Dataset for the ShanghaiTech crowd counting dataset \n","class EnhancedShanghaiTechDataset(Dataset):\n","\n","    # Initialize the dataset and define all configuration parameters \n","    def __init__(\n","        self,\n","        root_dir,\n","        gt_downsample=4,\n","        shuffle=False,\n","        sigma_base=5,\n","        target_size=(768, 768),\n","        normalize_dm=True\n","    ):\n","\n","        # Store the root directory containing images and ground-truth folders \n","        self.root_dir = root_dir \n"," \n","        # Store the density-map downsampling factor \n","        self.gt_downsample = gt_downsample \n"," \n","        # Store whether image filenames should be shuffled \n","        self.shuffle = shuffle \n"," \n","        # Store the base Gaussian sigma used to generate density maps \n","        self.sigma_base = sigma_base \n","  \n","        # Store the target image size as (height, width) \n","        self.target_size = target_size \n"," \n","        # Store whether density maps should be normalized to the GT count \n","        self.normalize_dm = normalize_dm \n"," \n","        # Get all JPG image filenames from the images directory \n","        # Sorting makes the initial dataset order deterministic \n","        self.img_names = sorted( \n","            f \n","            for f in os.listdir(os.path.join(root_dir, 'images')) \n","            if f.endswith('.jpg') \n","        ) \n"," \n","        # Shuffle the image filenames if shuffle=True \n","        if self.shuffle: \n","            random.shuffle(self.img_names) \n"," \n","        # Create a dictionary to store the number of people in each image \n","        self.n_people = {} \n"," \n","        # Create a dictionary to store the precomputed density map of each image \n","        self.DMs = {} \n"," \n","        # Precompute density maps and ground-truth counts for every image \n","        for img_name in self.img_names: \n"," \n","            # Construct the complete path to the image \n","            img_path = os.path.join(root_dir, 'images', img_name) \n"," \n","            # Construct the corresponding MATLAB ground-truth file path \n","            GT_path = os.path.join( \n","                root_dir, \n","                'ground-truth', \n","                f\"GT_{os.path.splitext(img_name)[0]}.mat\" \n","            ) \n"," \n","            # Load the MATLAB file and extract the annotated head-point coordinates \n","            GT = loadmat(GT_path)['image_info'][0, 0][0, 0][0] \n"," \n","            # Read the image using OpenCV and convert BGR color to RGB \n","            img = cv2.cvtColor(cv2.imread(img_path), cv2.COLOR_BGR2RGB) \n"," \n","            # Resize the image to the desired target size \n","            resized_img = cv2.resize(img, self.target_size) \n"," \n","            # Generate the density map using the resized image and original GT points \n","            dm = self.generate_density_map( \n","                resized_img, \n","                GT, \n","                original_shape=img.shape[:2] \n","            ) \n"," \n","            # Store the generated density map using the image path as the key \n","            self.DMs[img_path] = dm \n"," \n","            # Store the number of annotated people in the image \n","            self.n_people[img_path] = len(GT) \n"," \n","    # Generate a density map from the annotated head-point coordinates \n","    def generate_density_map(self, img, points, original_shape): \n"," \n","        # Get the height and width of the resized image \n","        height, width = img.shape[:2] \n"," \n","        # Create an empty floating-point density map initialized with zeros \n","        density_map = np.zeros((height, width), dtype=np.float32) \n","\n","        # Calculate the horizontal scaling factor from original image to resized image \n","        x_scale = width / original_shape[1]\n","\n","        # Calculate the vertical scaling factor from original image to resized image \n","        y_scale = height / original_shape[0]\n","\n","        # Use a smaller Gaussian sigma for highly crowded images \n","        sigma = self.sigma_base * (\n","            0.5 if len(points) > 100 else 1.0\n","        )\n","\n","        for point in points:\n","            # Convert the original x-coordinate to the resized image coordinate \n","            x = int(point[0] * x_scale)\n","\n","            # Convert the original y-coordinate to the resized image coordinate \n","            y = int(point[1] * y_scale)\n","\n","            # Skip points that fall outside the resized image boundaries \n","            if 0 <= x < width and 0 <= y < height:\n","               # Place one unit of density at the person's annotated location \n","                density_map[y, x] += 1.0  # Preserve overlapping annotations\n","\n","        if len(points) > 0:\n","            density_map = gaussian_filter(\n","                density_map,\n","                sigma=sigma,\n","                truncate=3\n","            )\n","\n","        # Normalize the density map so its total sum equals the GT person count \n","        if (self.normalize_dm and len(points) > 0 and density_map.sum() > 0):\n","\n","            # Scale the density map to preserve the total number of people \n","            density_map *= len(points) / density_map.sum()  # Preserve GT count\n","\n","        return density_map\n","\n","\n","    # Return the total number of images in the dataset \n","    def __len__(self): \n"," \n","        # The dataset length is the number of image filenames \n","        return len(self.img_names) \n","\n","\n","    # Retrieve one training sample using its index \n","    def __getitem__(self, idx): \n"," \n","        # Get the filename corresponding to the requested index \n","        img_name = self.img_names[idx] \n"," \n","        # Construct the complete image path \n","        img_path = os.path.join(self.root_dir, 'images', img_name) \n"," \n","        # Read the image and convert it from BGR to RGB \n","        img = cv2.cvtColor(cv2.imread(img_path), cv2.COLOR_BGR2RGB) \n"," \n","        # Resize the image to the target dimensions \n","        img = cv2.resize(img, self.target_size) \n"," \n","        # Retrieve the precomputed density map for this image \n","        gt_density_map = self.DMs[img_path] \n"," \n","        # Retrieve the ground-truth number of people \n","        gt_n_people = self.n_people[img_path] \n"," \n","        # Get the height and width after augmentation \n","        h, w = img.shape[:2] \n"," \n","        # Calculate the density-map dimensions after downsampling \n","        ds_h = h // self.gt_downsample \n","        ds_w = w // self.gt_downsample \n"," \n","        # Resize the image so its dimensions are divisible by the downsampling factor \n","        img = cv2.resize(img, (ds_w * self.gt_downsample, ds_h * self.gt_downsample)) \n"," \n","        # Downsample the ground-truth density map \n","        gt_density_map = cv2.resize(gt_density_map, (ds_w, ds_h)) \n"," \n","        # Add a channel dimension and compensate density values for downsampling \n","        gt_density_map = (gt_density_map[np.newaxis, :, :] * (self.gt_downsample ** 2)) \n"," \n","        # Convert the image from HWC format to CHW format and then to a PyTorch tensor \n","        img_tensor = torch.from_numpy(img.transpose(2, 0, 1)).float() / 255.0 \n"," \n","        # Convert the density map into a floating-point PyTorch tensor \n","        dm_tensor = torch.from_numpy(gt_density_map).float() \n"," \n","        return img_tensor, dm_tensor, gt_n_people"]},{"cell_type":"code","execution_count":5,"id":"453c2a6f","metadata":{"execution":{"iopub.execute_input":"2026-10-13T06:06:48.603595Z","iopub.status.busy":"2026-10-13