,"id":"1c3f4460","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:55:08.475994Z","iopub.status.busy":"2026-09-21T14:55:08.475739Z","iopub.status.idle":"2026-09-21T14:55:08.481053Z","shell.execute_reply":"2026-09-21T14:55:08.480481Z"},"papermill":{"duration":0.014446,"end_time":"2026-09-21T14:55:08.482424+00:00","exception":false,"start_time":"2026-09-21T14:55:08.467978+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torch\n","import torch.nn as nn\n","\n","# Defines a custom loss function class\n","class CombinedLoss(nn.Module):            \n","    # Initializes the loss weights\n","    def __init__(self, weight_dmap=0.9, weight_sum_gt=0.1):  \n","        # Initializes the parent nn.Module class\n","        super(CombinedLoss, self).__init__()                 \n","\n","        # Gives 90% importance to density-map loss\n","        self.weight_dmap = weight_dmap      \n","        # Gives 10% importance to total-count loss\n","        self.weight_sum_gt = weight_sum_gt  \n","\n","        # Creates MSE loss for pixel-wise density-map comparison\n","        self.img_loss = nn.MSELoss()        \n","        # Creates MAE/L1 loss for total-count comparison\n","        self.gt_loss_mae = nn.L1Loss()      \n","\n","    # Defines how the combined loss is calculated\n","    def forward(self, predications, density_maps, gt_counts):\n","        # Converts ground-truth counts to floating-point values\n","        gt_counts = gt_counts.float()                       \n","        \n","        # Calculates pixel-wise MSE between predicted and GT density maps\n","        img_loss = self.img_loss(predications, density_maps)        \n","\n","        # Sums all pixels to obtain predicted object counts\n","        pred_counts = torch.squeeze(predications.sum(dim=(2,3)))\n","\n","        # Calculates MAE between predicted and true counts\n","        gt_loss_mae = self.gt_loss_mae(pred_counts, gt_counts)  \n","\n","        # Combines both losses using their weights\n","        combined_loss = self.weight_dmap * img_loss + self.weight_sum_gt * gt_loss_mae  \n","\n","        return combined_loss, gt_loss_mae"]},{"cell_type":"code","execution_count":14,"id":"39886de8","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:55:08.497957Z","iopub.status.busy":"2026-09-21T14:55:08.497384Z","iopub.status.idle":"2026-09-21T14:55:08.501919Z","shell.execute_reply":"2026-09-21T14:55:08.501312Z"},"papermill":{"duration":0.013556,"end_time":"2026-09-21T14:55:08.503223+00:00","exception":false,"start_time":"2026-09-21T14:55:08.489667+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torch.optim as optim\n","\n","criterion = CombinedLoss(weight_dmap=0.9, weight_sum_gt=0.1)\n","optimizer = optim.Adam(model.parameters(), lr=1e-4)\n","scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=10, gamma=0.1)"]},{"cell_type":"code","execution_count":15,"id":"8f266764","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:55:08.519207Z","iopub.status.busy":"2026-09-21T14:55:08.518938Z","iopub.status.idle":"2026-09-21T14:55:08.524587Z","shell.execute_reply":"2026-09-21T14:55:08.523827Z"},"papermill":{"duration":0.014945,"end_time":"2026-09-21T14:55:08.525956+00:00","exception":false,"start_time":"2026-09-21T14:55:08.511011+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","Output directory: /kaggle/working/csrnet_results\n"]}],"source":["NUM_EPOCHS = 100\n","\n","PATIENCE = 30\n","OUTPUT_DIR = Path(\"/kaggle/working/csrnet_results\")\n","\n","OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n","\n","BEST_MODEL_PATH = (OUTPUT_DIR / \"csrnet_best.pth\")\n","LATEST_MODEL_PATH = (OUTPUT_DIR / \"csrnet_latest.pth\")\n","HISTORY_CSV_PATH = (OUTPUT_DIR / \"csrnet_training_history.csv\")\n","\n","print(\"\\nOutput directory:\", OUTPUT_DIR)"]},{"cell_type":"code","execution_count":16,"id":"2f61cfce","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:55