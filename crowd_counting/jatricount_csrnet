if shuffle=True \n        if self.shuffle: \n            random.shuffle(self.img_names) \n \n        # Create a dictionary to store the number of people in each image \n        self.n_people = {} \n \n        # Create a dictionary to store the precomputed density map of each image \n        self.DMs = {} \n \n        # Precompute density maps and ground-truth counts for every image \n        for img_name in self.img_names: \n \n            # Construct the complete path to the image \n            img_path = os.path.join(root_dir, 'images', img_name) \n \n            # Construct the corresponding MATLAB ground-truth file path \n            GT_path = os.path.join( \n                root_dir, \n                'ground-truth', \n                f\"GT_{os.path.splitext(img_name)[0]}.mat\" \n            ) \n \n            # Load the MATLAB file and extract the annotated head-point coordinates \n            GT = loadmat(GT_path)['image_info'][0, 0][0, 0][0] \n \n            # Read the image using OpenCV and convert BGR color to RGB \n            img = cv2.cvtColor(cv2.imread(img_path), cv2.COLOR_BGR2RGB) \n \n            # Resize the image to the desired target size \n            resized_img = cv2.resize(img, self.target_size) \n \n            # Generate the density map using the resized image and original GT points \n            dm = self.generate_density_map( \n                resized_img, \n                GT, \n                original_shape=img.shape[:2] \n            ) \n \n            # Store the generated density map using the image path as the key \n            self.DMs[img_path] = dm \n \n            # Store the number of annotated people in the image \n            self.n_people[img_path] = len(GT) \n \n    # Generate a density map from the annotated head-point coordinates \n    def generate_density_map(self, img, points, original_shape): \n \n        # Get the height and width of the resized image \n        height, width = img.shape[:2] \n \n        # Create an empty floating-point density map initialized with zeros \n        density_map = np.zeros((height, width), dtype=np.float32) \n\n        # Calculate the horizontal scaling factor from original image to resized image \n        x_scale = width / original_shape[1]\n\n        # Calculate the vertical scaling factor from original image to resized image \n        y_scale = height / original_shape[0]\n\n        # Use a smaller Gaussian sigma for highly crowded images \n        sigma = self.sigma_base * (\n            0.5 if len(points) > 100 else 1.0\n        )\n\n        for point in points:\n            # Convert the original x-coordinate to the resized image coordinate \n            x = int(point[0] * x_scale)\n\n            # Convert the original y-coordinate to the resized image coordinate \n            y = int(point[1] * y_scale)\n\n            # Skip points that fall outside the resized image boundaries \n            if 0 <= x < width and 0 <= y < height:\n               # Place one unit of density at the person's annotated location \n                density_map[y, x] += 1.0  # Preserve overlapping annotations\n\n        if len(points) > 0:\n            density_map = gaussian_filter(\n                density_map,\n                sigma=sigma,\n                truncate=3\n            )\n\n        # Normalize the density map so its total sum equals the GT person count \n        if (self.normalize_dm and len(points) > 0 and density_map.sum() > 0):\n\n            # Scale the density map to preserve the total number of people \n            density_map *= len(points) / density_map.sum()  # Preserve GT count\n\n        return density_map\n\n\n    # Return the total number of images in the dataset \n    def __len__(self): \n \n        # The dataset length is the number of image filenames \n        return len(self.img_names) \n\n\n    # Retrieve one training sample using its index \n    def __getitem__(self, idx): \n \n        # Get the filename corresponding to the requested index \n        img_name = self.img_names[idx] \n \n        # Construct the complete image path \n        img_path = os.path.join(self.root_dir, 'images', img_name) \n \n        # Read the image and convert it from BGR to RGB \n        img = cv2.cvtColor(cv2.imread(img_path), cv2.COLOR_BGR2RGB) \n \n        # Resize the image to the target dimensions \n        img = cv2.resize(img, self.target_size) \n \n        # Retrieve the precomputed density map for this image \n        gt_density_map = self.DMs[img_path] \n \n        # Retrieve the ground-truth number of people \n        gt_n_people = self.n_people[img_path] \n \n        # Get the height and width after augmentation \n        h, w = img.shape[:2] \n \n        # Calculate the density-map dimensions after downsampling \n        ds_h = h // self.gt_downsample \n        ds_w = w // self.gt_downsample \n \n        # Resize the image so its dimensions are divisible by the downsampling factor \n        img = cv2.resize(img, (ds_w * self.gt_downsample, ds_h * self.gt_downsample)) \n \n        # Downsample the ground-truth density map \n        gt_density_map = cv2.resize(gt_density_map, (ds_w, ds_h)) \n \n        # Add a channel dimension and compensate density values for downsampling \n        gt_density_map = (gt_density_map[np.newaxis, :, :] * (self.gt_downsample ** 2)) \n \n        # Convert the image from HWC format to CHW format and then to a PyTorch tensor \n        img_tensor = torch.from_numpy(img.transpose(2, 0, 1)).float() / 255.0 \n \n        # Convert the density map into a floating-point PyTorch tensor \n        dm_tensor = torch.from_numpy(gt_density_map).float() \n \n        return img_tensor, dm_tensor, gt_n_people","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-19T06:58:06.008682Z","iopub.execute_input":"2026-09-19T06:58:06.008978Z","iopub.status.idle":"2026-09-19T06:58:07.533019Z","shell.execute_reply.started":"2026-09-19T06:58:06.008956Z","shell.execute_reply":"2026-09-19T06:5