in_indices = indices[:train_size]\n","val_indices = indices[train_size:]\n","\n","# Create training and validation subsets\n","train_dataset = Subset(train_root_data, train_indices)\n","val_dataset = Subset(train_root_data, val_indices)\n","\n","print(\"Total samples:\", len(train_root_data))\n","print(\"Training samples:\", len(train_dataset))\n","print(\"Validation samples:\", len(val_dataset))"]},{"cell_type":"code","execution_count":9,"id":"c0ea4ab4","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:54:44.477832Z","iopub.status.busy":"2026-09-21T14:54:44.477479Z","iopub.status.idle":"2026-09-21T14:55:04.272712Z","shell.execute_reply":"2026-09-21T14:55:04.271804Z"},"papermill":{"duration":19.803768,"end_time":"2026-09-21T14:55:04.274212+00:00","exception":false,"start_time":"2026-09-21T14:54:44.470444+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Number of batches in train_loader: 45\n","Number of batches in val_loader: 5\n","Number of batches in test_loader: 40\n"]}],"source":["from torch.utils.data import DataLoader\n","\n","batch_size = 8\n","\n","train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=False, pin_memory=torch.cuda.is_available())\n","val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False, pin_memory=torch.cuda.is_available())\n","\n","# ✅ Test set\n","test_root_dir = \"/kaggle/input/datasets/tthien/shanghaitech/ShanghaiTech/part_B/test_data\"\n","test_set = EnhancedShanghaiTechDataset(test_root_dir, gt_downsample=4, shuffle=False)\n","test_loader = DataLoader(test_set, batch_size=batch_size, shuffle=False, pin_memory=torch.cuda.is_available())\n","\n","print(\"Number of batches in train_loader:\", len(train_loader))\n","print(\"Number of batches in val_loader:\", len(val_loader))\n","print(\"Number of batches in test_loader:\", len(test_loader))"]},{"cell_type":"code","execution_count":10,"id":"48b5c1cf","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:55:04.288371Z","iopub.status.busy":"2026-09-21T14:55:04.288049Z","iopub.status.idle":"2026-09-21T14:55:04.296499Z","shell.execute_reply":"2026-09-21T14:55:04.295724Z"},"papermill":{"duration":0.017255,"end_time":"2026-09-21T14:55:04.297979+00:00","exception":false,"start_time":"2026-09-21T14:55:04.280724+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","import torchvision.models as models\n","\n","class CSRNet(nn.Module):\n","\n","    def __init__(\n","        self,\n","        pretrained=True,\n","        freeze_frontend=True\n","    ):\n","\n","        super().__init__()\n","\n","        # VGG16 FRONTEND\n","        if pretrained:\n","            vgg = models.vgg16(\n","                weights=models.VGG16_Weights.IMAGENET1K_V1\n","            )\n","        else:\n","            vgg = models.vgg16(weights=None)\n","\n","        # VGG16 through conv4_3\n","        # This gives: 768x768 -> 96x96\n","        self.frontend = nn.Sequential(\n","            *list(vgg.features.children())[:23]\n","        )\n","\n","        # Freeze VGG frontend\n","        if freeze_frontend:\n","            for param in self.frontend.parameters():\n","                param.requires_grad = False\n","\n","        # BACKEND\n","        backend_layers = []\n","\n","        filters = [\n","            512,\n","            512,\n","            512,\n","            256,\n","            128,\n","            64\n","        ]\n","\n","        in_channels = 512\n","\n","        for out_channels in filters:\n","\n","            conv = nn.Conv2d(\n","                in_channels,\n","                out_channels,\n","                kernel_size=3,\n","                padding=2,\n","                dilation=2,\n","                bias=True\n","            )\n","\n","            nn.init.kaiming_normal_(\n","                conv.weight,\n","                mode=\"fan_out\",\n","                nonlinearity=\"relu\"\n","            )\n","\n","            nn.init.zeros_(conv.bias)\n","\n","            backend_layers.append(conv)\n","            backend_layers.append(nn.ReLU(inplace=True))\n","\n","            in_channels = out_channels\n","\n","        self.backend = nn.Sequential(*backend_layers)\n","\n","        # DENSITY HEAD\n","        self.density_head = nn.Conv2d(\n","            64,\n","            1,\n","            kernel_size=1,\n","            padding=0,\n","            bias=True\n","        )\n","\n","        nn.init.xavier_uniform_(\n","            self.density_head.weight\n","        )\n","\n","        nn.init.zeros_(\n","            self.density_head.bias\n","        )\n","\n","        # UPSAMPLE TO GT RESOLUTION\n","        self.upsample = nn.Upsample(\n","            scale_factor=2,\n","            mode=\"bilinear\",\n","            align_corners=False\n","        )\n","\n","    # FORWARD\n","    def forward(self, x):\n","\n","        # 768x768 -> 96x96\n","        x = self.frontend(x)\n","\n","        # 96x96 -> 96x96\n","        x = self.backend(x)\n","\n","        # 96x96 -> 96x96\n","        x = self.density_head(x)\n","\n","        # 96x96 -> 192x192\n","        x = self.upsample(x)\n","\n","        return x"]},{"cell_type":"markdown","id":"362aaa3a","metadata":{"papermill":{"duration":0.006014,"end_time":"2026-09-21T14:55:04.309925+00:00","exception":false,"start_time":"2026-09-21T14:55:04.303911+00:00","status":"completed"},"tags":[]},"source":["# CSRNet\n","\n","![CSRNet Architecture](https://raw.githubusercontent.com/masum184e/spl_03/main/images/dense/csrnet/architecture.png)\n","\n","**CSRNet-style crowd-density estimation network** built from two main components:\n","\n","1. **VGG16 frontend**: extracts visual features from the input image.\n","2. **Dilated convolution backend + density head**: converts those features into a 1-channel crowd density map.\n","\n","For a `768 × 768` RGB input, the intended tensor flow is:\n","\n","```\n","Input image\n","[B, 3, 768, 768]\n","        │\n","        ▼\n"," VGG16 Frontend\n","        │\n","        │  spatial downsampling ×8\n","        ▼\n","[B, 512, 96, 96]\n","        │\n","        ▼\n"," Dilated Backend\n","        │\n","        │  spatial size preserved\n","        ▼\n","[B, 64, 96, 96]\n","        │\n","        ▼\n"," 1×1 Density Head\n","        │\n","        ▼\n","[B, 1, 96, 96]\n","        │\n","        ▼\n"," Bilinear Upsampling ×2\n","        │\n","        ▼\n","[B, 1, 192, 192]\n","```\n","\n","So the final density map is **192 × 192**, not the original `768 × 768`.\n","\n","## VGG16 Frontend\n","\n","The frontend starts with:\n","\n","```\n","vgg = models.vgg16(\n","    weights=models.VGG16_Weights.IMAGENET1K_V1\n",")\n","```\n","\n","This loads a standard **VGG16** network with ImageNet pretrained weights.\n","\n","VGG16's feature extractor consists primarily of:\n","\n","- `3×3` convolution layers\n","- ReLU activations\n","- `2×2` max-pooling layers\n","\n","Your code takes:\n","\n","```\n","list(vgg.features.children())[:23]\n","```\n","\n","This corresponds to the VGG16 feature layers through **`conv4_3`**, including the preceding pooling operations.\n","\n"," Conceptually:\n","\n","```\n","Input\n","  │\n","  ├── Conv 3×3, 64\n","  ├── ReLU\n","  ├── Conv 3×3, 64\n","  ├── ReLU\n","  ├── MaxPool\n","  │\n","  ├── Conv 3×3, 128\n","  ├── ReLU\n","  ├── Conv 3×3, 128\n","  ├── ReLU\n","  ├── MaxPool\n","  │\n","  ├── Conv 3×3, 256\n","  ├── ReLU\n","  ├── Conv 3×3, 256\n","  ├── ReLU\n","  ├── Conv 3×3, 256\n","  ├── ReLU\n","  ├── MaxPool\n","  │\n","  ├── Conv 3×3, 512\n","  ├── ReLU\n","  ├── Conv 3×3, 512\n","  ├── ReLU\n","  ├── Conv 3×3, 512\n","  └── ReLU\n","```\n","\n","The important point is that the frontend contains **three pooling operations**.\n","\n","Each pooling operation reduces spatial resolution by approximately 2:\n","\n","```\n","768 × 768\n","     ↓ /2\n","384 × 384\n","     ↓ /2\n","192 × 192\n","     ↓ /2\n","96 × 96\n","```\n","\n","Therefore:\n","\n","```\n","768 × 768 → 96 × 96\n","```\n","\n"," while the number of channels increases to:\n","\n","```\n","512\n","```\n","\n"," giving:\n","\n","```\n","[B, 512, 96, 96]\n","```\n","\n","### Why the VGG16 Frontend Is Used\n","\n","The frontend acts as a **feature extractor**.\n","\n","Instead of trying to predict the density map directly from RGB pixels, the network first transforms the image into high level feature representations.\n","\n","For example, early layers can represent things such as:\n","\n","```\n","edges\n","textures\n","corners\n","```\n","\n","while deeper layers represent more complex visual structures:\n","\n","```\n","heads\n","bodies\n","people like patterns\n","crowd structures\n","```\n","\n","For crowd counting, these features are useful because the network doesn't necessarily need to identify every person perfectly. It needs to learn visual evidence corresponding to **local crowd density**.\n","\n","## Pretrained VGG16\n","\n"," You use:\n","\n","```\n","weights=models.VGG16_Weights.IMAGENET1K_V1\n","```\n","\n","Therefore the frontend starts with weights learned from **ImageNet** rather than random initialization.\n","\n","This is useful because VGG16 already contains generic visual feature detectors.\n","\n","The model can therefore start from:\n","\n","```\n","    ImageNet trained visual features\n","                ↓\n","        adapt them to\n","                ↓\n","    crowd density estimation\n","```\n","\n"," rather than learning all visual features from scratch.\n","\n","### Freezing the Frontend\n","\n","You have:\n","\n","```python\n","if freeze_frontend:\n","    for param in self.frontend.parameters():\n","        param.requires_grad = False\n","```\n","\n","With:\n","\n","```python\n","freeze_frontend=True\n","```\n","\n","the VGG16 frontend becomes **frozen**.\n","\n","That means during training:\n","\n","```\n","VGG16 weights\n","    ↓\n","do not change\n","```\n","\n","while the backend and density head can learn.\n","\n","The effective trainable architecture becomes:\n","\n","```\n","      Frozen VGG16\n","           │\n","           ▼\n","Trainable dilated backend\n","           │\n","           ▼\n","Trainable density head\n","```\n","\n","This reduces the number of parameters that need to be optimized and preserves the pretrained VGG representation.\n","\n","If you set:\n","\n","```py\n","freeze_frontend=False\n","```\n","\n","then the VGG16 layers will also receive gradients and be fine-tuned.\n","\n","## Dilated Convolution Backend\n","\n","The second major part is:\n","\n","```py\n","filters = [\n","    512,\n","    512,\n","    512,\n","    256,\n","    128,\n","    64\n","]\n","```\n","\n","The backend contains **six convolutional layers**.\n","\n","Every convolution uses:\n","\n","```py\n","kernel_size=3\n","padding=2\n","dilation=2\n","```\n","\n","So every layer is a:\n","\n","**3×3 dilated convolution with dilation rate 2.**\n","\n","### Why Dilation = 2?\n","\n","A normal `3×3` convolution samples:\n","\n","```\n","XXX\n","XXX\n","XXX\n","```\n","\n","A dilation-2 convolution inserts gaps between the kernel elements:\n","\n","```\n","X . X . X\n",". . . . .\n","X . X . X\n",". . . . .\n","X . X . X\n","```\n","\n","Although the actual kernel still has only:\n","\n","```\n","3 × 3 = 9\n","```\n","\n","learnable weights, its **effective receptive field** is:\n","\n","```\n","5 × 5\n","```\n","\n","The effective kernel size can be calculated as:\n","\n","$$\n","K_{\\text{effective}}\n","=\n","K+(K-1)(d-1)\n","$$\n","\n","For:\n","\n","$$\n","K=3,\\quad d=2\n","$$\n","\n","we get:\n","\n","$$\n","3+(3-1)(2-1)=5\n","$$\n","\n","So each backend convolution sees a **5×5 effective region** without reducing the spatial resolution.\n","\n","### Why Dilated Convolutions Are Useful for Crowd Counting\n","\n","This is particularly important in crowd density estimation.\n","\n","The network needs to understand both:\n","\n","* local information\n","* larger spatial context\n","\n","For example, a small image patch may contain:\n","\n","```\n","one person's head\n","```\n","\n","but a larger region might contain:\n","\n","```\n","many overlapping heads\n","```\n","\n","Dilated convolutions increase the receptive field without using additional pooling.\n","\n","This allows the backend to capture broader crowd context while maintaining the `96 × 96` feature resolution.\n","\n","## Backend Weight Initialization\n","\n","Unlike the VGG frontend, the backend is initialized from scratch.\n","\n","You use:\n","\n","```py\n","nn.init.kaiming_normal_(\n","    conv.weight,\n","    mode=\"fan_out\",\n","    nonlinearity=\"relu\"\n",")\n","```\n","\n","This is **Kaiming/He initialization**, which is particularly appropriate for layers followed by ReLU.\n","\n","The biases are initialized to zero:\n","\n","```py\n","nn.init.zeros_(conv.bias)\n","```\n","\n","So:\n","\n","```\n","VGG frontend → pretrained\n","Backend      → Kaiming initialized\n","Density head → Xavier initialized\n","```\n","\n","## Density Head\n","\n","After the six backend convolutions:\n","\n","```\n","[B, 64, 96, 96]\n","```\n","\n","you apply:\n","\n","```py\n","self.density_head = nn.Conv2d(\n","    64,\n","    1,\n","    kernel_size=1,\n","    padding=0,\n","    bias=True\n",")\n","```\n","\n","This is a **1×1 convolution**.\n","\n","Its job is to convert the 64 channel feature representation into a single density value at every spatial location.\n","\n","Conceptually:\n","\n","```\n","64 feature channels\n","       │\n","       ▼\n","    1×1 Conv\n","       │\n","       ▼\n","1 density channel\n","```\n","\n","Therefore:\n","\n","```\n","[B, 64, 96, 96]\n","        ↓\n","[B, 1, 96, 96]\n","```\n","\n","Each pixel in this output represents the model's predicted crowd density value at that location.\n","\n","### Why a 1×1 Convolution?\n","\n","A `1×1` convolution doesn't look at neighboring spatial pixels.\n","\n","Instead, at every `(x, y)` location it performs a learned combination of the 64 feature channels:\n","\n","$$\n","D(x,y)\n","=\n","\\sum_{c=1}^{64} w_cF_c(x,y)+b\n","$$\n","\n","So it effectively converts:\n","\n","```\n","64-dimensional feature vector\n","```\n","\n","into:\n","\n","```\n","1-dimensional density value\n","```\n","\n","for every spatial position.\n","\n","## Density Head Initialization\n","\n","You initialize it with:\n","\n","```py\n","nn.init.xavier_uniform_(\n","    self.density_head.weight\n",")\n","```\n","\n","and:\n","\n","```py\n","nn.init.zeros_(\n","    self.density_head.bias\n",")\n","```\n","\n","Xavier initialization is commonly used for maintaining a reasonable scale of activations at initialization.\n","\n","## Upsampling\n","\n","The raw density prediction is:\n","\n","```\n","[B, 1, 96, 96]\n","```\n","\n","Then you apply:\n","\n","```py\n","self.upsample = nn.Upsample(\n","    scale_factor=2,\n","    mode=\"bilinear\",\n","    align_corners=False\n",")\n","```\n","\n","which produces:\n","\n","```\n","[B, 1, 192, 192]\n","```\n","\n","The spatial dimensions are doubled:\n","\n","$$\n","96\\times2=192\n","$$\n","\n","using **bilinear interpolation**.\n","\n","Importantly, this is not a learnable upsampling layer. It contains **no trainable parameters**.\n","\n","## Complete Tensor Flow\n","\n","For a batch of RGB images with batch size `B`:\n","\n","```\n","Input\n","[B, 3, 768, 768]\n","        │\n","        ▼\n","VGG16 conv1\n","[B, 64, 768, 768]\n","        │\n","        ▼\n","MaxPool\n","[B, 64, 384, 384]\n","        │\n","        ▼\n","VGG16 conv2\n","[B, 128, 384, 384]\n","        │\n","        ▼\n","MaxPool\n","[B, 128, 192, 192]\n","        │\n","        ▼\n","VGG16 conv3\n","[B, 256, 192, 192]\n","        │\n","        ▼\n","MaxPool\n","[B, 256, 96, 96]\n","        │\n","        ▼\n","VGG16 conv4\n","[B, 512, 96, 96]\n","        │\n","        ▼\n","Dilated Conv\n","512 → 512\n","[B, 512, 96, 96]\n","        │\n","        ▼\n","Dilated Conv\n","512 → 512\n","[B, 512, 96, 96]\n","        │\n","        ▼\n","Dilated Conv\n","512 → 512\n","[B, 512, 96, 96]\n","        │\n","        ▼\n","Dilated Conv\n","512 → 256\n","[B, 256, 96, 96]\n","        │\n","        ▼\n","Dilated Conv\n","256 → 128\n","[B, 128, 96, 96]\n","        │\n","        ▼\n","Dilated Conv\n","128 → 64\n","[B, 64, 96, 96]\n","        │\n","        ▼\n","1×1 Conv\n","64 → 1\n","[B, 1, 96, 96]\n","        │\n","        ▼\n","Bilinear ×2\n","[B, 1, 192, 192]\n","```\n","\n","## Receptive Field vs. Resolution\n","\n","One of the key design ideas in your architecture is:\n","\n","**The frontend performs spatial downsampling, while the backend increases the receptive field without further downsampling.**\n","\n","So instead of doing:\n","\n","```\n","768\n"," ↓\n","384\n"," ↓\n","192\n"," ↓\n","96\n"," ↓\n","48\n"," ↓\n","24\n","```\n","\n","the network stops at:\n","\n","```\n","96 × 96\n","```\n","\n","and uses dilation to capture larger context.\n","\n","This is important because excessive pooling would make the density map very coarse.\n","\n","Your backend therefore maintains:\n","\n","```\n","96 × 96\n","```\n","\n","through all six layers.\n","\n","## What the Model Actually Predicts\n","\n","The output is:\n","\n","```\n","return x\n","```\n","\n","with shape:\n","\n","```\n","[B, 1, 192, 192]\n","```\n","\n","This is intended to be a **density map**, rather than a direct count.\n","\n","For an image containing people, the density map ideally has high values around locations corresponding to people.\n","\n","Conceptually:\n","\n","```\n","Image                  Density map\n","\n","┌───────────────┐      ┌───────────────┐\n","│  •  •         │      │  ·  ·         │\n","│     •  •      │  →   │     ·  ·      │\n","│ •       •     │      │ ·       ·     │\n","└───────────────┘      └───────────────┘\n","```\n","\n","The predicted total crowd count can then be obtained by integrating/summing the density map, assuming the ground-truth density-map construction and output scaling are consistent:\n","\n","$$\n","\\text{Count}\\approx\\sum_{x,y}D(x,y)\n","$$\n"]},{"cell_type":"code","execution_count":11,"id":"3831af9a","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:55:04.323083Z","iopub.status.busy":"2026-09-21T14:55:04.322607Z","iopub.status.idle":"2026-09-21T14:55:08.436558Z","shell.execute_reply":"2026-09-21T14:55:08.435917Z"},"papermill":{"duration":4.122365,"end_time":"2026-09-21T14:55:08.438213+00:00","exception":false,"start_time":"2026-09-21T14:55:04.315848+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Downloading: \"https://download.pytorch.org/models/vgg16-397923af.pth\" to /root/.cache/torch/hub/checkpoints/vgg16-397923af.pth\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 528M/528M [00:02<00:00, 239MB/s]\n"]}],"source":["model = CSRNet(pretrained=True, freeze_frontend=True).to(DEVICE)"]},{"cell_type":"code","execution_count":12,"id":"1c1d35a0","metadata":{"execution":{"iopub.execute_input":"2026-09-21T14:55:08.454542Z","iopub.status.busy":"2026-09-21T14:55:08.453913Z","iopub.status.idle":"2026-09-21T14:55:08.459707Z","shell.execute_reply":"2026-09-21T14:55:08.459083Z"},"papermill":{"duration":0.01497,"end_time":"2026-09-21T14:55:08.461014+00:00","exception":false,"start_time":"2026-09-21T14:55:08.446044+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["CSRNet(\n","  (frontend): Sequential(\n","    (0): Conv2d(3, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (1): ReLU(inplace=True)\n","    (2): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (3): ReLU(inplace=True)\n","    (4): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","    (5): Conv2d(64, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (6): ReLU(inplace=True)\n","    (7): Conv2d(128, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1,