1 = max(0, y1)\n","            x2 = min(width - 1, x2)\n","            y2 = min(height - 1, y2)\n","\n","            boxes.append((x1, y1, x2, y2))\n","\n","    return boxes"]},{"cell_type":"code","execution_count":20,"id":"e4c01832","metadata":{"execution":{"iopub.execute_input":"2026-09-26T08:46:02.742265Z","iopub.status.busy":"2026-09-26T08:46:02.741478Z","iopub.status.idle":"2026-09-26T08:46:02.747078Z","shell.execute_reply":"2026-09-26T08:46:02.746465Z"},"papermill":{"duration":0.43014,"end_time":"2026-09-26T08:46:02.748501+00:00","exception":false,"start_time":"2026-09-26T08:46:02.318361+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def calculate_iou(box_a, box_b):\n","\n","    ax1, ay1, ax2, ay2 = box_a\n","    bx1, by1, bx2, by2 = box_b\n","\n","    # --------------------------------------------------------\n","    # Intersection\n","    # --------------------------------------------------------\n","    inter_x1 = max(ax1, bx1)\n","    inter_y1 = max(ay1, by1)\n","    \n","    inter_x2 = min(ax2, bx2)\n","    inter_y2 = min(ay2, by2)\n","\n","    inter_width = max(0, inter_x2 - inter_x1)\n","    inter_height = max(0, inter_y2 - inter_y1)\n","\n","    intersection = (inter_width * inter_height)\n","\n","    # --------------------------------------------------------\n","    # Areas\n","    # --------------------------------------------------------\n","    area_a = max(0, ax2 - ax1) * max(0, ay2 - ay1)\n","    area_b = max(0, bx2 - bx1) * max(0, by2 - by1)\n","\n","    union = (area_a + area_b - intersection)\n","\n","    if union <= 0:\n","        return 0.0\n","\n","    return (intersection /union)"]},{"cell_type":"code","execution_count":21,"id":"d334e8de","metadata":{"execution":{"iopub.execute_input":"2026-09-26T08:46:03.657234Z","iopub.status.busy":"2026-09-26T08:46:03.656584Z","iopub.status.idle":"2026-09-26T08:46:03.663526Z","shell.execute_reply":"2026-09-26T08:46:03.66267Z"},"papermill":{"duration":0.509605,"end_time":"2026-09-26T08:46:03.665015+00:00","exception":false,"start_time":"2026-09-26T08:46:03.15541+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def match_detections(gt_boxes, pred_boxes,iou_threshold=0.50):\n","    matched_gt = set()\n","    matched_pred = set()\n","\n","    matches = []\n","\n","    # Create all possible matches\n","    candidates = []\n","\n","    for pred_index, pred_box in enumerate(pred_boxes):\n","        for gt_index, gt_box in enumerate(gt_boxes):\n","            iou = calculate_iou(pred_box, gt_box)\n","            \n","            if iou >= iou_threshold:\n","                candidates.append((iou, pred_index, gt_index ))\n","    # Highest IoU first\n","    candidates.sort(reverse=True)\n","\n","    # Greedy one-to-one matching\n","    for (iou, pred_index, gt_index) in candidates:\n","        if (pred_index in matched_pred):\n","            continue\n","            \n","        if (gt_index in matched_gt):\n","            continue\n","\n","        matched_pred.add(pred_index)\n","        matched_gt.add(gt_index)\n","\n","        matches.append((pred_index, gt_index, iou))\n","\n","    # Calculate TP, FP, FN\n","    tp = len(matches)\n","    fp = (len(pred_boxes) - tp)\n","    fn = (len(gt_boxes) - tp)\n","\n","    return (tp, fp, fn, matches)"]},{"cell_type":"code","execution_count":22,"id":"52c8928e","metadata":{"execution":{"iopub.execute_input":"2026-09-26T08:46:04.499647Z","iopub.status.busy":"2026-09-26T08:46:04.499187Z","iopub.status.idle":"2026-09-26T08:46:50.460238Z","shell.execute_reply":"2026-09-26T08:46:50.459467Z"},"papermill":{"duration":46.378389,"end_time":"2026-09-26T08:46:50.462087+00:00","exception":false,"start_time":"2026-09-26T08:46:04.083698+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["Processing images: 100%|██████████| 285/285 [00:45<00:00,  6.20it/s]\n"]}],"source":["import matplotlib.pyplot as plt\n","from matplotlib.patches import Rectangle\n","from tqdm import