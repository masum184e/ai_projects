orch.cuda.manual_seed_all(SEED)\n","\n","# Make cuDNN use deterministic algorithms when possible\n","torch.backends.cudnn.deterministic = True\n","\n","# Disable cuDNN's automatic algorithm benchmarking\n","# torch.backends.cudnn.benchmark = False\n","\n","# Force PyTorch to use deterministic algorithms where supported\n","# warn_only=True gives a warning instead of stopping if an operation\n","# has no deterministic implementation\n","# torch.use_deterministic_algorithms(True, warn_only=True)\n","\n","print(\"Random seed:\", SEED)"]},{"cell_type":"code","execution_count":3,"id":"4d8cedd9","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:30:51.492145Z","iopub.status.busy":"2026-09-26T06:30:51.49171Z","iopub.status.idle":"2026-09-26T06:30:51.543274Z","shell.execute_reply":"2026-09-26T06:30:51.54245Z"},"papermill":{"duration":0.059982,"end_time":"2026-09-26T06:30:51.544688+00:00","exception":false,"start_time":"2026-09-26T06:30:51.484706+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["PyTorch version: 2.10.0+cu128\n","CUDA available: True\n","Using device: 0\n","GPU: Tesla T4\n"]}],"source":["import torch\n","\n","# Check CUDA\n","print(\"PyTorch version:\", torch.__version__)\n","print(\"CUDA available:\", torch.cuda.is_available())\n","\n","DEVICE = 0 if torch.cuda.is_available() else \"cpu\"\n","\n","print(\"Using device:\", DEVICE)\n","\n","if torch.cuda.is_available():\n","    print(\"GPU:\", torch.cuda.get_device_name(0))"]},{"cell_type":"markdown","id":"88126894","metadata":{"papermill":{"duration":0.006059,"end_time":"2026-09-26T06:30:51.556907+00:00","exception":false,"start_time":"2026-09-26T06:30:51.550848+00:00","status":"completed"},"tags":[]},"source":["# Goal\n","\n","The overall goal is:\n","\n","> **Given an image containing people, detect individual human heads and estimate the total number of people by counting the detected heads.**\n","\n","![Detection Goal](https://raw.githubusercontent.com/masum184e/spl_03/main/images/detection_goal.png)\n","\n","Suppose an image contains:\n","\n","```text\n","Actual people = 120\n","```\n","\n","The model should detect the individual heads:\n","\n","```text\n","              ┌─────────┐\n","              │  head   │\n","              └─────────┘\n","\n","       ┌─────────┐\n","       │  head   │\n","       └─────────┘\n","\n","                    ┌─────────┐\n","                    │  head   │\n","                    └─────────┘\n","\n","              ...\n","```\n","\n","If the detector identifies 118 heads, then:\n","\n","```text\n","Predicted heads = 118\n","```\n","\n","and the estimated crowd count becomes:\n","\n","```text\n","Predicted count = 118\n","```\n","\n","So instead of directly predicting:\n","\n","```text\n","image → 120\n","```\n","\n","the model performs:\n","\n","```text\n","image → head detections → head count\n","```\n","\n","This is the fundamental idea behind the **detection based crowd counting approach**.\n","\n","## Head Detection\n","\n","In a crowded image, each person is represented by a visible head region.\n","\n","For example:\n","\n","```text\n","┌─────────────────────────────────────┐\n","│                                  │\n","│      ◯        ◯                │\n","│                                  │\n","│  ◯        ◯       ◯           │\n","│                                  │\n","│       ◯       ◯        ◯      │\n","│                                  │\n","└─────────────────────────────────────┘\n","```\n","\n","Instead of generating a continuous density map, the detection-based approach attempts to locate each head individually.\n","\n","The model predicts a bounding box around each detected head:\n","\n","```text\n","Head location\n","      ↓\n","Bounding box\n","      ↓\n","Confidence score\n","      ↓\n","Detected head\n","```\n","\n","For example:\n","\n","```text\n","                Bounding Box\n","          ┌───────────────────┐\n","          │        ◯          │\n","          │      head         │\n","          └───────────────────┘\n","                 0.91\n","```\n","\n","Here:\n","\n","```text\n","0.91\n","```\n","\n","represents the model's confidence in the detection.\n","\n","### Bounding Box Annotation\n","\n","Each annotated head is represented using a bounding box.\n","\n","Conceptually:\n","\n","```text\n","                x\n","                ↓\n","          ┌───────────┐\n","          │           │\n","          │   head    │\n","          │           │\n","          └───────────┘\n","                    ↑\n","                    y\n","```\n","\n","A YOLO annotation contains information describing:\n","\n","```text\n","class\n","x-center\n","y-center\n","width\n","height\n","```\n","\n","The coordinates are normalized relative to the image dimensions.\n","\n","For example:\n","\n","```text\n","0 0.52 0.31 0.06 0.08\n","```\n","\n","can be interpreted as:\n","\n","```text\n","class       = head\n","x-center    = 0.52\n","y-center    = 0.31\n","width       = 0.06\n","height      = 0.08\n","```\n","\n","The first value:\n","\n","```text\n","0\n","```\n","\n","identifies the object as a **head**, because the dataset contains only one class.\n","\n","### YOLOv8m Head Detector\n","\n","The detection model used in this branch is **YOLOv8m**.\n","\n","The overall process is:\n","\n","```text\n","Input Image\n","     │\n","     ▼\n","YOLOv8m\n","     │\n","     ▼\n","Feature Extraction\n","     │\n","     ▼\n","Head Detection\n","     │\n","     ▼\n","Bounding Boxes + Confidence\n","```\n","\n","The model is initialized from pretrained YOLOv8m weights and then fine tuned on the SCUT HEAD dataset.\n","\n","Conceptually:\n","\n","```text\n","Pretrained YOLOv8m\n","        │\n","        ▼\n"," SCUT HEAD Training\n","        │\n","        ▼\n","Fine tuned Head Detector\n","```\n","\n","The model is trained specifically for the single class:\n","\n","```text\n","head\n","```\n","\n","## High Resolution Detection\n","\n","The detector is trained using an image size of:\n","\n","```text\n","1280 × 1280\n","```\n","\n","This is particularly relevant for crowd images because heads can occupy relatively small regions of an image.\n","\n","For example:\n","\n","```text\n","Low resolution\n","\n","   ●  ● ●\n"," ● ● ● ● ●\n","```\n","\n","may lose some small object information.\n","\n","Using a larger input resolution provides the detector with more spatial information:\n","\n","```text\n","High resolution\n","\n","      ┌───┐       ┌───┐\n","      │ ● │       │ ● │\n","      └───┘       └───┘\n","\n","  ┌───┐ ┌───┐ ┌───┐ ┌───┐\n","  │ ● │ │ ● │ │ ● │ │ ● │\n","  └───┘ └───┘ └───┘ └───┘\n","```\n","\n","This is useful when detecting heads in distant rows or densely populated scenes.\n","\n","### Detection Process\n","\n","Consider an image containing several people:\n","\n","```text\n","┌───────────────────────────────────┐\n","│                                   │\n","│      ●       ●       ●            │\n","│                                   │\n","│   ●       ●       ●       ●      │\n","│                                   │\n","│ ●    ●       ●       ●       ●   │\n","│                                   │\n","└───────────────────────────────────┘\n","```\n","\n","YOLO processes the image and produces candidate detections:\n","\n","```text\n","                Input Image\n","                     │\n","                     ▼\n","                  YOLOv8m\n","                     │\n","                     ▼\n","            Candidate Detections\n","                     │\n","                     ▼\n","              Confidence Filter\n","                     │\n","                     ▼\n","             Non Maximum Suppression\n","                     │\n","                     ▼\n","              Final Head Detections\n","```\n","\n","Each final detection contains information such as:\n","\n","```text\n","┌────────────────────────────────────┐\n","│ Bounding Box                       │\n","│ Confidence                         │\n","│ Class = head                       │\n","└────────────────────────────────────┘\n","```\n","\n","### Confidence Threshold\n","\n","Not every prediction generated by the detector should be considered a valid head.\n","\n","For example:\n","\n","```text\n","Detection 1 → 0.92\n","Detection 2 → 0.87\n","Detection 3 → 0.63\n","Detection 4 → 0.21\n","Detection 5 → 0.08\n","```\n","\n","With a confidence threshold of:\n","\n","```text\n","0.25\n","```\n","\n","detections below the threshold are discarded.\n","\n","Conceptually:\n","\n","```text\n","YOLO Predictions\n","       │\n","       ├── confidence < 0.25 → discard\n","       │\n","       └── confidence ≥ 0.25 → keep\n","```\n","\n","The remaining detections are then used for counting.\n","\n","### Non Maximum Suppression\n","\n","Sometimes the detector can produce multiple overlapping predictions for the same head.\n","\n","For example:\n","\n","```text\n","        ┌───────────────┐\n","        │   ┌───────┐   │\n","        │   │ head  │   │\n","        │   └───────┘   │\n","        └───────────────┘\n","```\n","\n","These overlapping predictions may correspond to the same person.\n","\n","**Non Maximum Suppression (NMS)** removes redundant detections and keeps the most appropriate prediction.\n","\n","Conceptually:\n","\n","```text\n","Multiple predictions\n","        ↓\n","     NMS\n","        ↓\n","One final detection\n","```\n","\n","This prevents the same head from being counted multiple times.\n","\n","### From Detection to Count\n","\n","After filtering and NMS, suppose YOLO produces:\n","\n","```text\n","Detection 1\n","Detection 2\n","Detection 3\n","...\n","Detection 120\n","```\n","\n","The number of remaining detections is used as the estimated crowd count:\n","\n","$$\n","C_{YOLO}=N_{\\text{detections}}\n","$$\n","\n","Therefore:\n","\n","```text\n","Number of detected heads\n","            ↓\n","       Crowd count\n","```\n","\n","For example:\n","\n","```text\n","Detected heads = 120\n","\n","        ↓\n","\n","YOLO Count = 120\n","```\n","\n","Unlike density based counting, there is no need to sum a density map.\n","\n","### Sparse Crowd Counting\n","\n","This detector is particularly useful for the **sparse scene branch**.\n","\n","The complete branch can be represented as:\n","\n","```text\n","Input Image\n","     │\n","     ▼\n","YOLOv8m Head Detector\n","     │\n","     ▼\n","Head Bounding Boxes\n","     │\n","     ▼\n","Confidence Filtering\n","     │\n","     ▼\n","Non Maximum Suppression\n","     │\n","     ▼\n","Final Head Detections\n","     │\n","     ▼\n","Count Detections\n","     │\n","     ▼\n","Sparse Crowd Count\n","```\n","\n","For example:\n","\n","```text\n","Input image\n","     │\n","     ▼\n","8 detected heads\n","     │\n","     ▼\n","Sparse count = 8\n","```\n","\n","This approach is straightforward when individual heads can be localized reliably.\n","\n","## Detection Based vs Density Based Counting\n","\n","The main difference between the two approaches can be summarized as:\n","\n","### Detection based approach\n","\n","```text\n","Image\n","  ↓\n","Detect individual heads\n","  ↓\n","Bounding boxes\n","  ↓\n","Count boxes\n","  ↓\n","Crowd count\n","```\n","\n","For detection based counting:\n","\n","$$\n","C = \\sum_{i=1}^{N}1=N\n","$$\n","\n","where $N$ is the number of final detected heads.\n","\n","### Density based approach\n","\n","```text\n","Image\n","  ↓\n","Generate density map\n","  ↓\n","Sum density values\n","  ↓\n","Crowd count\n","```\n","\n","For density based counting:\n","\n","$$\n","C=\\sum_{x,y}D(x,y)\n","$$\n","\n","where $D(x,y)$ represents the predicted density at each spatial location.\n","\n","Thus, the two branches estimate the same final quantity **the number of people** but use fundamentally different representations."]},{"cell_type":"code","execution_count":4,"id":"84c24efb","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:30:51.570182Z","iopub.status.busy":"2026-09-26T06:30:51.569528Z","iopub.status.idle":"2026-09-26T06:30:59.047262Z","shell.execute_reply":"2026-09-26T06:30:59.046564Z"},"papermill":{"duration":7.486067,"end_time":"2026-09-26T06:30:59.049024+00:00","exception":false,"start_time":"2026-09-26T06:30:51.562957+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m46.7/46.7 kB\u001b[0m \u001b[31m1.3 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\r\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m1.5/1.5 MB\u001b[0m \u001b[31m19.6 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\r\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m91.0/91.0 kB\u001b[0m \u001b[31m3.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\r\n","\u001b[?25h"]}],"source":["!pip install ultralytics -q"]},{"cell_type":"code","execution_count":5,"id":"c6157b0d","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:30:59.063537Z","iopub.status.busy":"2026-09-26T06:30:59.063121Z","iopub.status.idle":"2026-09-26T06:30:59.606682Z","shell.execute_reply":"2026-09-26T06:30:59.605877Z"},"papermill":{"duration":0.552397,"end_time":"2026-09-26T06:30:59.608144+00:00","exception":false,"start_time":"2026-09-26T06:30:59.055747+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Creating new Ultralytics Settings v0.0.8 file ✅ \n","View Ultralytics Settings with 'yolo settings' or at '/root/.config/Ultralytics/settings.json'\n","Update Settings with 'yolo settings key=value', i.e. 'yolo settings runs_dir=path/to/dir'. For help see https://docs.ultralytics.com/usage/settings.\n","Ultralytics (YOLO) version: 8.4.163\n"]}],"source":["import ultralytics\n","\n","print(\"Ultralytics (YOLO) version:\", ultralytics.__version__)"]},{"cell_type":"markdown","id":"7d3789e6","metadata":{"papermill":{"duration":0.006997,"end_time":"2026-09-26T06:30:59.621692+00:00","exception":false,"start_time":"2026-09-26T06:30:59.614695+00:00","status":"completed"},"tags":[]},"source":["# Overall workflow\n","\n","The complete process is:\n","\n","```text\n","SCUT HEAD Dataset\n","       │\n","       ├── Part A\n","       │    ├── train\n","       │    ├── valid\n","       │    └── test\n","       │\n","       ├── Part B\n","       │    ├── train\n","       │    ├── valid\n","       │    └── test\n","       └──────────────   \n","                    │\n","                    ▼\n","          Dataset Statistics\n","                    │\n","                    ▼\n","        Combine Part A + Part B\n","                    │\n","                    ▼\n","             YOLO Dataset YAML\n","                    │\n","                    ▼\n","              YOLOv8m Training\n","                    │\n","                    ▼\n","          Training Visualizations\n","                    │\n","                    ▼\n","          Best Model: best.pt\n","                    │\n","                    ▼\n","              Model Validation\n","                    │\n","                    ▼\n","     Precision / Recall / mAP@50 / mAP@50:95\n","```\n","\n","The purpose of the pipeline is to train a **single class object detector**, where the only object class is:\n","\n","```text\n","head\n","```\n","\n","This is particularly suitable for your crowd counting system because the trained detector can identify individual heads, allowing the number of detected heads to serve as a sparse scene crowd count.\n"]},{"cell_type":"code","execution_count":6,"id":"e6460532","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:30:59.6358Z","iopub.status.busy":"2026-09-26T06:30:59.635061Z","iopub.status.idle":"2026-09-26T06:31:00.770329Z","shell.execute_reply":"2026-09-26T06:31:00.769367Z"},"papermill":{"duration":1.14389,"end_time":"2026-09-26T06:31:00.771909+00:00","exception":false,"start_time":"2026-09