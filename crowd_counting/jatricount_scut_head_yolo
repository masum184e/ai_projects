 = 0\n","    part_images = 0\n","    part_label_files = 0\n","    part_annotations = 0\n","\n","    for split in [\"train\", \"valid\", \"test\"]:\n","        image_dir = part / split / \"images\"\n","        label_dir = part / split / \"labels\"\n","\n","        # Count images\n","        images = (\n","            sum(1 for f in image_dir.iterdir() if f.is_file())\n","            if image_dir.exists()\n","            else 0\n","        )\n","\n","        # Count label files and annotations\n","        label_files = 0\n","        annotations = 0\n","\n","        if label_dir.exists():\n","            for label_file in label_dir.iterdir():\n","                if label_file.is_file():\n","                    label_files += 1\n","\n","                    with open(label_file, \"r\") as f:\n","                        annotations += sum(\n","                            1 for line in f if line.strip()\n","                        )\n","\n","        print(\n","            f\"{split:>5}: \"\n","            f\"images={images:,}, \"\n","            f\"label_files={label_files:,}, \"\n","            f\"annotations={annotations:,}\"\n","        )\n","\n","        part_images += images\n","        part_label_files += label_files\n","        part_annotations += annotations\n","\n","    print(\n","          f\"total: \"\n","          f\"images={part_images:,} \"\n","          f\"label_files={part_label_files:,} \"\n","          f\"annotations={part_annotations:,}\"\n","    )\n","    print(f\"Part {part_name} total: {part_total:,}\")\n","\n","    grand_images += part_images\n","    grand_label_files += part_label_files\n","    grand_annotations += part_annotations\n","\n","print(\"\\n============================\")\n","print(\"GRAND TOTAL\")\n","print(f\"Images:       {grand_images:,}\")\n","print(f\"Label files:  {grand_label_files:,}\")\n","print(f\"Total files:  {grand_images + grand_label_files:,}\")\n","print(f\"Annotations:  {grand_annotations:,}\")"]},{"cell_type":"code","execution_count":8,"id":"9b51fc49","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:32:56.13561Z","iopub.status.busy":"2026-09-26T06:32:56.135065Z","iopub.status.idle":"2026-09-26T06:33:16.135875Z","shell.execute_reply":"2026-09-26T06:33:16.134757Z"},"papermill":{"duration":20.009573,"end_time":"2026-09-26T06:33:16.137437+00:00","exception":false,"start_time":"2026-09-26T06:32:56.127864+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Total files to copy: 8,658\n"]}],"source":["import shutil\n","from pathlib import Path\n","\n","PART_A = Path(\"/kaggle/input/datasets/hoangxuanviet/scut-head/PartA\")\n","PART_B = Path(\"/kaggle/input/datasets/hoangxuanviet/scut-head/PartB\")\n","\n","COMBINED_PATH = Path(\"/kaggle/working/scut_head\")\n","\n","files_to_copy = []\n","\n","for part_name, part in [(\"A\", PART_A), (\"B\", PART_B)]:\n","\n","    for split in [\"train\", \"valid\", \"test\"]:\n","\n","        for folder in [\"images\", \"labels\"]:\n","\n","            src = part / split / folder\n","\n","            if src.exists():\n","                for f in sorted(src.iterdir()):\n","\n","                    if f.is_file():\n","                        new_name = f\"part{part_name}_{f.name}\"\n","                        dst = (\n","                            COMBINED_PATH\n","                            / split\n","                            / folder\n","                            / new_name\n","                        )\n","\n","                        files_to_copy.append((f, dst))\n","\n","print(f\"Total files to copy: {len(files_to_copy):,}\")"]},{"cell_type":"code","execution_count":9,"id":"0324648f","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:33:16.152403Z","iopub.status.busy":"2026-09-26T06:33:16.151839Z","iopub.status.idle":"2026-09-26T06:35:05.523015Z","shell.execute_reply":"2026-09-26T06:35:05.522321Z"},"papermill":{"duration":109.380399,"end_time":"2026-09-26T06:35:05.524729+