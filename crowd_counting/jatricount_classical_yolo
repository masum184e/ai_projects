id_labels.append(f\"{label_path.name}: invalid height\")\n","\n","if invalid_labels:\n","    print(\"Invalid annotations:\")\n","    for x in invalid_labels:\n","        print(x)\n","else:\n","    print(\"✓ All annotations are valid.\")"]},{"cell_type":"code","execution_count":12,"id":"f42a1c37","metadata":{"execution":{"iopub.execute_input":"2026-09-21T17:05:39.285942Z","iopub.status.busy":"2026-09-21T17:05:39.285555Z","iopub.status.idle":"2026-09-21T17:05:39.293023Z","shell.execute_reply":"2026-09-21T17:05:39.292025Z"},"papermill":{"duration":0.017232,"end_time":"2026-09-21T17:05:39.295207+00:00","exception":false,"start_time":"2026-09-21T17:05:39.277975+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_gt_boxes(label_path, width, height):\n","\n","    boxes = []\n","\n","    if not label_path.exists():\n","        return boxes\n","\n","    with open(label_path, \"r\") as f:\n","\n","        for line in f:\n","            values = line.strip().split()\n","\n","            if len(values) != 5:\n","                continue\n","\n","            _, xc, yc, bw, bh = map(float, values)\n","\n","            # YOLO normalized -> pixels\n","            xc *= width\n","            yc *= height\n","            bw *= width\n","            bh *= height\n","\n","            x1 = xc - bw / 2\n","            y1 = yc - bh / 2\n","            x2 = xc + bw / 2\n","            y2 = yc + bh / 2\n","\n","            # Keep inside image\n","            x1 = max(0, x1)\n","            y1 = max(0, y1)\n","            x2 = min(width - 1, x2)\n","            y2 = min(height - 1, y2)\n","\n","            boxes.append((x1, y1, x2, y2))\n","\n","    return boxes"]},{"cell_type":"code","execution_count":13,"id":"179edcba","metadata":{"execution":{"iopub.execute_input":"2026-09-21T17:05:39.310233Z","iopub.status.busy":"2026-09-21T17:05:39.309857Z","iopub.status.idle":"2026-09-21T17:05:39.317813Z","shell.execute_reply":"2026-09-21T17:05:39.316909Z"},"papermill":{"duration":0.017969,"end_time":"2026-09-21T17:05:39.319947+00:00","exception":false,"start_time":"2026-09-21T17:05:39.301978+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def calculate_iou(box_a, box_b):\n","\n","    ax1, ay1, ax2, ay2 = box_a\n","    bx1, by1, bx2, by2 = box_b\n","\n","    # --------------------------------------------------------\n","    # Intersection\n","    # --------------------------------------------------------\n","    inter_x1 = max(ax1, bx1)\n","    inter_y1 = max(ay1, by1)\n","    \n","    inter_x2 = min(ax2, bx2)\n","    inter_y2 = min(ay2, by2)\n","\n","    inter_width = max(0, inter_x2 - inter_x1)\n","    inter_height = max(0, inter_y2 - inter_y1)\n","\n","    intersection = (inter_width * inter_height)\n","\n","    # --------------------------------------------------------\n","    # Areas\n","    # --------------------------------------------------------\n","    area_a = max(0, ax2 - ax1) * max(0, ay2 - ay1)\n","    area_b = max(0, bx2 - bx1) * max(0, by2 - by1)\n","\n","    union = (area_a + area_b - intersection)\n","\n","    if union <= 0:\n","        return 0.0\n","\n","    return (intersection /union)"]},{"cell_type":"code","execution_count":14,"id":"da31d03c","metadata":{"execution":{"iopub.execute_input":"2026-09-21T17:05:39.333653Z","iopub.status.busy":"2026-09-21T17:05:39.333265Z","iopub.status.idle":"2026-09-21T17:05:39.341437Z","shell.execute_reply":"2026-09-21T17:05:39.340462Z"},"papermill":{"duration":0.017543,"end_time":"2026-09-21T17:05:39.343457+00:00","exception":false,"start_time":"2026-09-21T17:05:39.325914+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def match_detections(gt_boxes, pred_boxes,iou_threshold=0.50):\n","    matched_gt = set()\n","    matched_pred = set()\n","\n","    matches = []\n","\n","    # Create all possible matches\n","    candidates = []\n","\n","    for pred_index, pred_box in enumerate(pred_boxes):\n","        for gt_index, gt_box in enumerate(gt_boxes):\n","            iou = calculate_iou(pred_box, gt_box)\n","            \n","            if iou >= iou_threshold:\n","                candidates.append((iou, pred_index, gt_index ))\n","    # Highest IoU first\n","    candidates.sort(reverse=True)\n","\n","    # Greedy one-to-one matching\n","    for (iou, pred_index, gt_index) in candidates:\n","        if (pred_index in matched_pred):\n","            continue\n","            \n","        if (gt_index in matched_gt):\n","            continue\n","\n","        matched_pred.add(pred_index)\n","        matched_gt.add(gt_index)\n","\n","        matches.append((pred_index, gt_index, iou))\n","\n","    # Calculate TP, FP, FN\n","    tp = len(matches)\n","    fp = (len(pred_boxes) - tp)\n","    fn = (len(gt_boxes) - tp)\n","\n","    return (tp, fp, fn, matches)"]},{"cell_type":"code","execution_count":15,"id":"796bbaec","metadata":{"execution":{"iopub.execute_input":"2026-09-21T17:05:39.357456Z","iopub.status.busy":"2026-09-21T17:05:39.357066Z","iopub.status.idle":"2026-09-21T17:13:55.130322Z","shell.execute_reply":"2026-09-21T17:13:55.12933Z"},"papermill":{"duration":495.783269,"end_time":"2026-09-21T17:13:55.132892+00:00","exception":false,"start_time":"2026-09-21T17:05:39.349623+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["Processing images: 100%|██████████| 285/285 [08:15<00:00,  1.74s/it]\n"]}],"source":["import matplotlib.pyplot as plt\n","from matplotlib.patches import Rectangle\n","from tqdm import tqdm\n","import cv2\n","\n","all_results = []\n","\n","for image_path in tqdm(image_files, desc=\"Processing images\"):\n","\n","    # READ IMAGE\n","    image_bgr = cv2.imread(str(image_path))\n","\n","    if image_bgr is None:\n","        print(f\"Could not read: {image_path}\")\n","        continue\n","\n","    height, width = (image_bgr.shape[:2])\n","\n","    # RGB copy for visualization\n","    image_rgb = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2RGB)\n","\n","    # LOAD GROUND TRUTH\n","    label_path = (LABEL_DIR / f\"{image_path.stem}.txt\")\n","\n","    gt_boxes = load_gt_boxes(label_path,width,height)\n","    gt_count = len(gt_boxes)\n","\n","    # PREPROCESS FOR HAAR\n","    gray = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2GRAY)\n","\n","    # Histogram equalization\n","    gray = cv2.equalizeHist(gray)\n","\n","    # YOLO Prediction\n","    prediction_result = model.predict(\n","        source=str(image_path),\n","        imgsz=1024,\n","        conf=0.25,\n","        device=DEVICE,\n","        verbose=False,\n","        classes=[0]\n","    )[0]\n","\n","\n","    if prediction_result.boxes is not None:\n","\n","        pred_boxes = (\n","            prediction_result\n","            .boxes\n","            .xyxy\n","            .cpu()\n","            .numpy()\n","        )\n","\n","    else:\n","\n","        pred_boxes = []\n","\n","\n","    pred_count = len(pred_boxes)\n","\n","    # COUNT ERROR\n","    error = (pred_count - gt_count)\n","    absolute_error = abs(error)\n","    squared_error = (error ** 2)\n","    \n","    # PERCENTAGE ERROR\n","    if gt_count > 0:\n","        percentage_error = (absolute_error / gt_count) * 100\n","    else:\n","        percentage_error = np.nan\n","\n","    # COUNTING ACCURACY\n","    if gt_count > 0:\n","        counting_accuracy = max(0, 1 - (absolute_error / gt_count)) * 100\n","    else:\n","        counting_accuracy = np.nan\n","            \n","    # MATCH DETECTIONS\n","    (tp, fp, fn, matches) = match_detections(gt_boxes, pred_boxes, iou_threshold=0.50)\n","\n","    # IMAGE-LEVEL PRECISION / RECALL / F1\n","    if (tp + fp > 0):\n","        precision = (tp / (tp + fp))\n","    else:\n","        precision = 0.0\n","\n","    if (tp + fn > 0):\n","        recall = (tp / (tp + fn))\n","    else:\n","        recall = 0.0\n","        \n","    if (precision + recall > 0):\n","        f1 = ( 2 * precision * recall / (precision + recall))\n","    else:\n","        f1 = 0.0\n","\n","    # STORE RESU