labels.append(f\"{label_path.name}: invalid height\")\n","\n","if invalid_labels:\n","    print(\"Invalid annotations:\")\n","    for x in invalid_labels:\n","        print(x)\n","else:\n","    print(\"✓ All annotations are valid.\")"]},{"cell_type":"code","execution_count":12,"id":"b881b244","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:13:40.015523Z","iopub.status.busy":"2026-09-26T06:13:40.015224Z","iopub.status.idle":"2026-09-26T06:13:40.021302Z","shell.execute_reply":"2026-09-26T06:13:40.020504Z"},"papermill":{"duration":0.013598,"end_time":"2026-09-26T06:13:40.023034+00:00","exception":false,"start_time":"2026-09-26T06:13:40.009436+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_gt_boxes(label_path, width, height):\n","\n","    boxes = []\n","\n","    if not label_path.exists():\n","        return boxes\n","\n","    with open(label_path, \"r\") as f:\n","\n","        for line in f:\n","            values = line.strip().split()\n","\n","            if len(values) != 5:\n","                continue\n","\n","            _, xc, yc, bw, bh = map(float, values)\n","\n","            # YOLO normalized -> pixels\n","            xc *= width\n","            yc *= height\n","            bw *= width\n","            bh *= height\n","\n","            x1 = xc - bw / 2\n","            y1 = yc - bh / 2\n","            x2 = xc + bw / 2\n","            y2 = yc + bh / 2\n","\n","            # Keep inside image\n","            x1 = max(0, x1)\n","            y1 = max(0, y1)\n","            x2 = min(width - 1, x2)\n","            y2 = min(height - 1, y2)\n","\n","            boxes.append((x1, y1, x2, y2))\n","\n","    return boxes"]},{"cell_type":"code","execution_count":13,"id":"d5e7ab29","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:13:40.033211Z","iopub.status.busy":"2026-09-26T06:13:40.03294Z","iopub.status.idle":"2026-09-26T06:13:40.037965Z","shell.execute_reply":"2026-09-26T06:13:40.037154Z"},"papermill":{"duration":0.011962,"end_time":"2026-09-26T06:13:40.039604+00:00","exception":false,"start_time":"2026-09-26T06:13:40.027642+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def calculate_iou(box_a, box_b):\n","\n","    ax1, ay1, ax2, ay2 = box_a\n","    bx1, by1, bx2, by2 = box_b\n","\n","    # --------------------------------------------------------\n","    # Intersection\n","    # --------------------------------------------------------\n","    inter_x1 = max(ax1, bx1)\n","    inter_y1 = max(ay1, by1)\n","    \n","    inter_x2 = min(ax2, bx2)\n","    inter_y2 = min(ay2, by2)\n","\n","    inter_width = max(0, inter_x2 - inter_x1)\n","    inter_height = max(0, inter_y2 - inter_y1)\n","\n","    intersection = (inter_width * inter_height)\n","\n","    # --------------------------------------------------------\n","    # Areas\n","    # --------------------------------------------------------\n","    area_a = max(0, ax2 - ax1) * max(0, ay2 - ay1)\n","    area_b = max(0, bx2 - bx1) * max(0, by2 - by1)\n","\n","    union = (area_a + area_b - intersection)\n","\n","    if union <= 0:\n","        return 0.0\n","\n","    return (intersection /union)"]},{"cell_type":"code","execution_count":14,"id":"c91b3d99","metadata":{"execution":{"iopub.execute_input":"2026-09-26T06:13:40.050318Z","iopub.status.busy":"2026-09-26T06:13:40.050025Z","iopub.status.idle":"2026-09-26T06:13:40.056198Z","shell.execute_reply":"2026-09-26T06:13:40.055329Z"},"papermill":{"duration":0.01306,"end_time":"2026-09-26T06:13:40.057527+00:00","exception":false,"start_time":"2026-09-26T06:13:40.044467+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def match_detections(gt_boxes, pred_boxes,iou_threshold=0.50):\n","    matched_gt = set()\n","    matched_pred = set()\n","\n","    matches = []\n","\n","    # Create all possible matches\n","    candidates = []\n","\n","    for pred_index, pred_box in enumerate(pred_boxes):\n","        for gt_index, gt_box in enumerate(gt_boxes):\n","            