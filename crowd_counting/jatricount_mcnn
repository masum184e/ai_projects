ining:   0%|          | 0/45 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"2c7ed8d631b2453497faa19dfeb9dc1c","version_major":2,"version_minor":0},"text/plain":["Validation:   0%|          | 0/5 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Current LR: 1.00e-13\n","TRAIN - Loss: 2.350162 | MAE: 23.4910\n","VAL   - Loss: 2.368650 | MAE: 23.6775\n","Early stopping triggered.\n","No validation improvement for 30 epochs.\n"]}],"source":["from tqdm.auto import tqdm\n","import pandas as pd\n","\n","for epoch in range(NUM_EPOCHS):\n","\n","    print(\"=\" * 60)\n","    print(f\"Epoch {epoch + 1}/{NUM_EPOCHS}\")\n","    print(\"=\" * 60)\n","\n","    # TRAIN\n","    model.train()\n","\n","    train_loss_total = 0.0\n","    train_mae_total = 0.0\n","\n","    progress_bar = tqdm(train_loader, desc=\"Training\", leave=False)\n","\n","    for images, density_maps, gt_counts in progress_bar:\n","        \n","        images = images.to(DEVICE, non_blocking=True)\n","        density_maps = density_maps.to(DEVICE, non_blocking=True)\n","        gt_counts = gt_counts.to(DEVICE, non_blocking=True)\n","\n","        # Forward + Backward\n","        optimizer.zero_grad(set_to_none=True)\n","        predictions = model(images)\n","        loss, count_mae = criterion(predictions, density_maps, gt_counts)\n","\n","        loss.backward()\n","\n","        # Gradient Clipping\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)\n","        optimizer.step()\n","\n","        # Accumulate Metrics\n","        batch_size_current = images.size(0)\n","        train_loss_total += (loss.item() * batch_size_current)\n","        train_mae_total += (count_mae.item() * batch_size_current)\n","\n","        progress_bar.set_postfix(loss=f\"{loss.item():.4f}\", mae=f\"{count_mae.item():.2f}\")\n","\n","    # Average Training Metrics\n","    train_loss = (train_loss_total / len(train_loader.dataset))\n","    train_mae = (train_mae_total / len(train_loader.dataset))\n","\n","    # VALIDATION\n","    model.eval()\n","\n","    val_loss_total = 0.0\n","    val_mae_total = 0.0\n","\n","    with torch.inference_mode():\n","        progress_bar = tqdm(val_loader, desc=\"Validation\", leave=False)\n","\n","        for images, density_maps, gt_counts in progress_bar:\n","\n","            images = images.to(DEVICE, non_blocking=True)\n","\n","            density_maps = density_maps.to(DEVICE, non_blocking=True)\n","            gt_counts = gt_counts.to(DEVICE, non_blocking=True)\n","\n","            predictions = model(images)\n","            loss, count_mae = criterion(predictions, density_maps, gt_counts)\n","\n","            batch_size_current = images.size(0)\n","\n","            val_loss_total += (loss.item() * batch_size_current)\n","            val_mae_total += (count_mae.item() * batch_size_current)\n","\n","    # Average Validation Metrics\n","    val_loss = (val_loss_total / len(val_loader.dataset))\n","    val_mae = (val_mae_total / len(val_loader.dataset))\n","\n","    # LEARNING RATE SCHEDULER\n","    scheduler.step()\n","    current_lr = optimizer.param_groups[0][\"lr\"]\n","    print(f\"Current LR: {current_lr:.2e}\")\n","\n","    # SAVE HISTORY\n","    train_losses.append(train_loss)\n","    val_losses.append(val_loss)\n","\n","    train_mae_losses.append(train_mae)\n","    val_mae_losses.append(val_mae)\n","\n","    # PRINT METRICS\n","    print(f\"TRAIN - Loss: {train_loss:.6f} | MAE: {train_mae:.4f}\")\n","    print(f\"VAL   - Loss: {val_loss:.6f} | MAE: {val_mae:.4f}\")\n","\n","    # SAVE BEST MODEL\n","    if val_loss < best_val_loss:\n","\n","        best_val_loss = val_loss\n","        best_epoch = epoch\n","        epochs_without_improvement = 0\n","\n","        torch.save(\n","            {\n","                \"epoch\": epoch + 1,\n","                \"model_state_dict\": model.state_dict(),\n","                \"optimizer_state_dict\": optimizer.state_dict(),\n","                \"best_val_loss\": best_val_loss,\n","\n","                \"train_losses\": train_losses,\n","                \"val_losses\": val_losses,\n","                \"train_mae_losses\": train_mae_losses,\n","                \"val_mae_losses\": val_mae_losses,\n","\n","                \"seed\": SEED,\n","                \"input_size\": (512, 512),\n","                \"gt_downsample\": 4,\n","                \"sigma\": 5,\n","                \"architecture\": \"FourColumnMCNN\",\n","                \"training_dataset\": \"ShanghaiTech Part B\"\n","            },\n","            BEST_MODEL_PATH\n","        )\n","\n","        print(f\"BEST MODEL SAVED (epoch {epoch + 1})\")\n","        print(f\"Best validation loss: {best_val_loss:.6f}\")\n","\n","    else:\n","        epochs_without_improvement += 1\n","\n","    # SAVE LATEST CHECKPOINT\n","    torch.save(\n","        {\n","            \"epoch\": epoch + 1,\n","            \"model_state_dict\": model.state_dict(),\n","            \"optimizer_state_dict\": optimizer.state_dict(),\n","            \"best_val_loss\": best_val_loss,\n","\n","            \"train_losses\": train_losses,\n","            \"val_losses\": val_losses,\n","            \"train_mae_losses\": train_mae_losses,\n","            \"val_mae_losses\": val_mae_losses,\n","\n","            \"seed\": SEED,\n","            \"input_size\": (512, 512),\n","            \"gt_downsample\": 4,\n","            \"sigma\": 5,\n","            \"architecture\": \"FourColumnMCNN\",\n","            \"training_dataset\": \"ShanghaiTech Part B\"\n","        },\n","        LATEST_MODEL_PATH\n","    )\n","\n","    # SAVE TRAINING HISTORY TO CSV\n","    history_df = pd.DataFrame(\n","        {\n","            \"epoch\": np.arange(1, len(train_losses) + 1),\n","            \n","            \"train_loss\": train_losses,\n","            \"val_loss\": val_losses,\n","\n","            \"train_mae\": train_mae_losses,\n","            \"val_mae\": val_mae_losses\n","        }\n","    )\n","\n","    history_df[\"is_best_epoch\"] = (history_df[\"epoch\"] == best_epoch + 1)\n","    history_df.to_csv(HISTORY_CSV_PATH, index=False)\n","\n","    # EARLY STOPPING\n","    if epochs_without_improvement >= PATIENCE:\n","        print(\"Early stopping triggered.\")\n","        print(f\"No validation improvement for {PATIENCE} epochs.\")\n","        break"]},{"cell_type":"markdown","id":"f202903d","metadata":{"papermill":{"duration":0.026474,"end_time":"2026-09-21T16:38:18.335031+00:00","exception":false,"start_time":"2026-09-21T16:38:18.308557+00:00","status":"completed"},"tags":[]},"source":["# Training\n","## `model.train()`\n","\n","At the beginning of training:\n","\n","```python\n","model.train()\n","```\n","\n","This tells PyTorch:\n","\n","> The model is currently being trained.\n","\n","This matters especially for layers such as BatchNorm.\n","\n","## Batch processing\n","\n","For every batch:\n","\n","```python\n","for images, density_maps, gt_counts in train_loader:\n","```\n","\n","you get:\n","\n","```text\n","images\n","density_maps\n","gt_counts\n","```\n","\n","For example:\n","\n","```text\n","images:\n","[8,3,768,768]\n","\n","density maps:\n","[8,1,192,192]\n","\n","counts:\n","[8]\n","```\n","\n","## Move data to GPU\n","\n","All tensors must be on the same device as the model.\n","\n","PyTorch generally cannot perform an operation between CPU tensors and GPU tensors. Therefore, i move the batch to same device.\n","\n","## Clear previous gradients\n","\n","PyTorch accumulates gradients by default.\n","\n","Therefore, before calculating gradients for a new batch, i clear the previous gradients.\n","\n","## Forward pass\n","\n","```python\n","predictions = model(images)\n","```\n","\n","This performs:\n","\n","```text\n","Images\n"," ↓\n","Column 1\n","Column 2\n","Column 3\n","Column 4\n"," ↓\n","Fusion\n"," ↓\n","Density map\n","```\n","\n","Output:\n","\n","```text\n","predictions\n","```\n","\n","## Calculate loss\n","\n","```python\n","loss, count_mae = criterion(\n","    predictions,\n","    density_maps,\n","    gt_counts\n",")\n","```\n","\n","This produces:\n","\n","```text\n","combined loss\n","+\n","count MAE\n","```\n","\n","## Backpropagation\n","\n","`loss` is actually a PyTorch Tensor.\n","\n","Conceptually:\n","```\n","loss = combined_loss\n","```\n","And PyTorch Tensor objects have a `.backward()` method.\n","\n","This calculates gradients(in `model`, generated during `model.train()`).\n","\n","Conceptually:\n","\n","```text\n","Loss\n"," ↓\n","How did each parameter contribute?\n"," ↓\n","Gradient\n","```\n","\n","The gradient tells the optimizer which direction to change each parameter.\n","\n","## Gradient clipping\n","\n","```python\n","torch.nn.utils.clip_grad_norm_(\n","    model.parameters(),\n","    max_norm=5.0\n",")\n","```\n","\n","This limits the gradient norm.\n","\n","Why?\n","\n","Sometimes gradients can become extremely large.\n","\n","This is called:\n","\n","> exploding gradients\n","\n","Gradient clipping prevents updates from becoming excessively large.\n","\n","## Optimizer update\n","\n","Then:\n","\n","```python\n","optimizer.step()\n","```\n","\n","Adam updates the network weights.\n","\n","So the full training sequence is:\n","\n","```text\n","Forward\n","   ↓\n","Loss\n","   ↓\n","Backward\n","   ↓\n","Gradient clipping\n","   ↓\n","Adam update\n","```\n","\n","This is repeated for every batch.\n","\n","## Accumulating training metrics\n","\n","The code does:\n","\n","```python\n","batch_size_current = images.size(0)\n","```\n","```\n","[batch_size, channels, height, width]\n","     ↑\n","   size(0)\n","```\n","\n","`.item()` extracts the ordinary Python number:\n","\n","```python\n","train_loss_total += (loss.item() * batch_size_current)\n","train_mae_total += (count_mae.item() * batch_size_current)\n","```\n","\n","**Why multiply by batch size?**\n","\n","Suppose you have 3 batches:\n","\n","```\n","Batch 1 → 10 images → loss = 2\n","Batch 2 → 10 images → loss = 4\n","Batch 3 →  5 images → loss = 8\n","```\n","\n","If you simply did:\n","```\n","total += loss\n","```\n","you would get:\n","```\n","2 + 4 + 8 = 14\n","```\n","and average by number of batches:\n","```\n","14 / 3 = 4.67\n","```\n","But that's not the true per-image average, because the last batch has only 5 images.\n","\n","Instead, multiply each batch's loss by its number of samples:\n","```\n","Batch 1: 2 × 10 = 20\n","Batch 2: 4 × 10 = 40\n","Batch 3: 8 ×  5 = 40\n","```\n","Total:\n","```\n","20 + 40 + 40 = 100\n","```\n","Total images:\n","```\n","10 + 10 + 5 = 25\n","```\n","Average:\n","```\n","100 / 25 = 4\n","```\n","That's the proper dataset-level average.\n","\n","This collects the loss over all batches.\n","\n","At the end:\n","\n","```python\n","train_loss =\n","train_loss_total / len(train_loader.dataset)\n","```\n","\n","So i get the average training loss.\n","\n","## Validation phase\n","\n","After training batches finish:\n","\n","```python\n","model.eval()\n","```\n","\n","This switches the model into evaluation mode.\n","\n","Then:\n","\n","```python\n","with torch.inference_mode():\n","```\n","\n","disables gradient tracking.\n","\n","Why?\n","\n","Because we aren't updating the model during validation.\n","\n","This saves memory and computation.\n","\n","**Why validation shouldn't update weights**\n","\n","If you trained on the validation data, the validation set would no longer be an independent measure of how well your model generalizes.\n","\n","## Validation forward pass\n","\n","Validation does:\n","\n","```text\n","validation image\n","       ↓\n","model\n","       ↓\n","density prediction\n","       ↓\n","combined loss\n","       ↓\n","validation metrics\n","```\n","\n","But importantly:\n","\n","```text\n","NO backward()\n","NO optimizer.step()\n","```\n","\n","So the model isn't trained on validation data.\n","\n","## Training vs validation\n","\n","Your loop is essentially:\n","\n","```text\n","TRAIN\n"," ├─ model.train()\n"," ├─ forward\n"," ├─ loss\n"," ├─ backward\n"," ├─ optimizer.step()\n"," │\n"," └───────────────┐\n","                 ▼\n","VALIDATION\n"," ├─ model.eval()\n"," ├─ inference\n"," ├─ loss\n"," └─ metrics\n","```\n","\n","## Learning-rate update\n","\n","After validation:\n","\n","```python\n","scheduler.step()\n","```\n","\n","Since i'm using `StepLR`, the learning rate decreases according to the fixed epoch schedule.\n","\n","## Recording history\n","\n","The code stores:\n","\n","```python\n","train_losses\n","val_losses\n","train_mae_losses\n","val_mae_losses\n","```\n","\n","These become lists like:\n","\n","```text\n","train_losses = [\n","  0.81,\n","  0.62,\n","  0.54,\n","  ...\n","]\n","```\n","\n","## Best validation model\n","\n","This is the key condition:\n","\n","```python\n","if val_loss < best_val_loss:\n","```\n","\n","If the current validation loss is better than everything before it:\n","\n","```text\n","save this model\n","```\n","\n","Then:\n","\n","```python\n","best_val_loss = val_loss\n","```\n","\n","and:\n","\n","```python\n","best_epoch = epoch\n","```\n","\n","### What gets saved?\n","\n","The checkpoint contains:\n","\n","```text\n","epoch\n","model_state_dict\n","optimizer_state_dict\n","best_val_loss\n","train_losses\n","val_losses\n","train_mae_losses\n","val_mae_losses\n","seed\n","input_size\n","gt_downsample\n","sigma\n","architecture\n","training_dataset\n","```\n","\n","This is good because the checkpoint contains not only weights but also useful training metadata. \n","\n","### Why save optimizer state?\n","\n","Suppose training stops at:\n","\n","```text\n","Epoch 45\n","```\n","\n","If you save only:\n","\n","```text\n","model weights\n","```\n","\n","you can't fully reproduce the optimizer's state.\n","\n","Saving:\n","\n","```python\n","optimizer_state_dict\n","```\n","\n","allows training to potentially continue more faithfully.\n","\n","## Early stopping\n","\n","Your code tracks:\n","\n","```python\n","epochs_without_improvement\n","```\n","\n","Every time validation loss improves:\n","\n","```text\n","counter = 0\n","```\n","\n","Otherwise:\n","\n","```text\n","counter += 1\n","```\n","\n","When:\n","\n","```text\n","counter >= 30\n","```\n","\n","training stops.\n","\n","### Why early stopping?\n","\n","Suppose:\n","\n","```text\n","Epoch 30: validation loss = 0.25\n","Epoch 31: 0.26\n","Epoch 32: 0.27\n","...\n","```\n","\n","The training loss may continue decreasing while validation performance gets worse.\n","\n","That can indicate:\n","\n","> overfitting\n","\n","Early stopping prevents wasting computation and helps avoid training far beyond the point of useful generalization.\n","\n","### What does the model actually learn?\n","\n","This is perhaps the most important conceptual question.\n","\n","The model isn't explicitly told:\n","\n","```text\n","\"There are 150 people.\"\n","```\n","\n","only.\n","\n","It receives:\n","\n","```text\n","Image\n","+\n","density map\n","```\n","\n","and learns a function:\n","\n","$$\n","f_\\theta(I)=\\hat D\n","$$\n","\n","where:\n","\n","* $I$ = input image\n","* $\\theta$ = neural-network parameters\n","* $\\hat D$ = predicted density map\n","\n","Then:\n","\n","$$\n","\\hat C = \\sum_{x,y}\\hat D(x,y)\n","$$\n","\n","So the complete function is:\n","\n","$$\n","I\n","\\rightarrow\n","f_\\theta(I)\n","\\rightarrow\n","\\hat D\n","\\rightarrow\n","\\sum\\hat D\n","\\rightarrow\n","\\hat C\n","$$\n"]},{"cell_type":"code","execution_count":18,"id":"f3b3dd23","metadata":{"execution":{"iopub.execute_input":"2026-09-21T16:38:18.389424Z","iopub.status.busy":"2026-09-21T16:38:18.388872Z","iopub.status.idle":"2026-09-21T16:38:18.394291Z","shell.execute_reply":"2026-09-21T16:38:18.393457Z"},"papermill":{"duration":0.033948,"end_time":"2026-09-21T16:38:18.395658+00:00","exception":false,"start_time":"2026-09-21T16:38:18.36171+00:00","status":"completed"},