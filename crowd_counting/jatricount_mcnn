orch.cuda.is_available())\nval_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False, pin_memory=torch.cuda.is_available())\n\n# ✅ Test set\ntest_root_dir = \"/kaggle/input/datasets/tthien/shanghaitech/ShanghaiTech/part_B/test_data\"\ntest_set = EnhancedShanghaiTechDataset(test_root_dir, gt_downsample=4, shuffle=False)\ntest_loader = DataLoader(test_set, batch_size=batch_size, shuffle=False, pin_memory=torch.cuda.is_available())\n\nprint(\"Number of batches in train_loader:\", len(train_loader))\nprint(\"Number of batches in val_loader:\", len(val_loader))\nprint(\"Number of batches in test_loader:\", len(test_loader))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:18.585692Z","iopub.execute_input":"2026-09-20T19:32:18.586064Z","iopub.status.idle":"2026-09-20T19:32:30.719582Z","shell.execute_reply.started":"2026-09-20T19:32:18.586039Z","shell.execute_reply":"2026-09-20T19:32:30.71885Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## DataLoader\n\nDataLoader, which takes a dataset and provides batches of samples.\n\nInstead of giving the model one image at a time, you can give it multiple images together.\n\nThe code uses `batch_size = 8`. Therefore, the model processes:\n\n```text\n8 images\n```\n\nat a time.\n\nThe DataLoader handles:\n\n* batching\n* shuffling\n* iteration\n* memory transfer\n\n```\n                 ShanghaiTech Part B\n                         │\n             ┌───────────┴───────────┐\n             │                       │\n        Training data             Test data\n             │                       │\n          90% / 10%                100%\n             │                       │\n       ┌─────┴─────┐                 │\n       │           │                 │\n     Train        Val              Test\n       │           │                 │\n       ▼           ▼                 ▼\n train_loader  val_loader       test_loader\n       │           │                 │\n       └───────────┴─────────────────┘\n                       │\n                  batch size = 8\n```","metadata":{}},{"cell_type":"code","source":"import torch.nn as nn\nimport torch.nn.functional as F\n\nclass FourColumnMCNN(nn.Module):\n    def __init__(self):\n        super(FourColumnMCNN, self).__init__()\n\n        # ✅ Very Large Receptive Field Column\n        self.column1 = nn.Sequential(\n            nn.Conv2d(3, 16, kernel_size=11, padding=5),\n            nn.BatchNorm2d(16),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(16, 32, kernel_size=9, padding=4),\n            nn.BatchNorm2d(32),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(32, 64, kernel_size=7, padding=3),\n            nn.BatchNorm2d(64),\n            nn.ReLU(),\n        )\n\n        # ✅ Large Receptive Field Column\n        self.column2 = nn.Sequential(\n            nn.Conv2d(3, 16, kernel_size=9, padding=4),\n            nn.BatchNorm2d(16),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(16, 32, kernel_size=7, padding=3),\n            nn.BatchNorm2d(32),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(32, 64, kernel_size=5, padding=2),\n            nn.BatchNorm2d(64),\n            nn.ReLU(),\n        )\n\n        # ✅ Medium Receptive Field Column\n        self.column3 = nn.Sequential(\n            nn.Conv2d(3, 20, kernel_size=7, padding=3),\n            nn.BatchNorm2d(20),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(20, 40, kernel_size=5, padding=2),\n            nn.BatchNorm2d(40),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(40, 80, kernel_size=3, padding=1),\n            nn.BatchNorm2d(80),\n            nn.ReLU(),\n        )\n\n        # ✅ Small Receptive Field Column (fine details for dense crowds)\n        self.column4 = nn.Sequential(\n            nn.Conv2d(3, 24, kernel_size=5, padding=2),\n            nn.BatchNorm2d(24),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(24, 48, kernel_size=3, padding=1),\n            nn.BatchNorm2d(48),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(48, 96, kernel_size=3, padding=1),\n            nn.BatchNorm2d(96),\n            nn.ReLU(),\n        )\n\n        # ✅ Fusion Layer\n        self.fusion = nn.Sequential(\n            nn.Conv2d(64 + 64 + 80 + 96, 64, kernel_size=1),\n            nn.ReLU(),\n            nn.Conv2d(64, 1, kernel_size=1),\n            nn.ReLU()\n        )\n\n    def forward(self, x):\n        x1 = self.column1(x)\n        x2 = self.column2(x)\n        x3 = self.column3(x)\n        x4 = self.column4(x)\n\n        x_cat = torch.cat((x1, x2, x3, x4), dim=1)\n        out = self.fusion(x_cat)\n        return out","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:30.720539Z","iopub.execute_input":"2026-09-20T19:32:30.7209Z","iopub.status.idle":"2026-09-20T19:32:30.732537Z","shell.execute_reply.started":"2026-09-20T19:32:30.720864Z","shell.execute_reply":"2026-09-20T19:32:30.731761Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Four Column MCNN\n\nThis is the heart of the system.\n\nThe basic idea is:\n\n```text\n                   Input image\n                       │\n       ┌───────────────┼───────┐\n       │       │       │       │\n       ▼       ▼       ▼       ▼\n   Column 1 Column 2 Column 3 Column 4\n       │       │       │       │\n       └───────┴───────┴───────┘\n                       │\n                    Concatenate\n                       │\n                    Fusion\n                       │\n                       ▼\n                Density Map\n```\n\n![MCNN Architecture](https://raw.githubusercontent.com/masum184e/spl_03/main/images/dense/mcnn/architecture.png)\n\n## Multiple Columns\n\nPeople can appear at different scales.\n\nFor example:\n\n```text\nLarge person\n      ↓\n████████\n\nMedium person\n      ↓\n █████\n\nTiny distant person\n      ↓\n ██\n```\n\nA single convolutional scale may not handle all of them equally well.\n\nMCNN therefore uses different convolution kernel sizes.\n\nYour four columns represent:\n\n1. Very large receptive field\n2. Large receptive field\n3. Medium receptive field\n4. Small receptive field\n\nThe implementation is explicitly structured this way. \n\n## Receptive Field\n\nThis is essential for understanding MCNN.\n\nA convolution kernel looks at a local area.\n\nFor:\n\n```text\n3×3\n```\n\nthe neuron sees a small neighborhood.\n\nFor:\n\n```text\n11×11\n```\n\nit sees a much larger neighborhood.\n\nSo:\n\n```text\n3×3 → local detail\n7×7 → larger context\n11×11 → even larger context\n```\n\nThis helps the network deal with different crowd scales.\n\n### Why small receptive fields help dense crowds?\n\nIn very dense scenes, people can be tiny.\n\nYou don't necessarily need a huge region.\n\nInstead, fine local patterns such as:\n\n```text\nhead\nshoulder\nsmall person structure\n```\n\ncan be important.\n\nSo Column 4 focuses more on local details.\n\n\n## Batch Normalization\n\nBatch Normalization normalizes intermediate feature activations.\n\nConceptually:\n\n```text\nConv\n ↓\nBatchNorm\n ↓\nReLU\n```\n\nIt can make training more stable.\n\n\n## ReLU\n\nReLU is:\n\n$$\nf(x)=\\max(0,x)\n$$\n\nSo:\n\n```text\n-5 → 0\n-1 → 0\n 0 → 0\n 2 → 2\n 7 → 7\n```\n\nIt introduces non-linearity.\n\n## Max Pooling\n\nThis reduces spatial dimensions by approximately half.\n\nFor example:\n\n```text\n768 × 768\n```\n\nbecomes:\n\n```text\n384 × 384\n```\n\nand another pooling:\n\n```text\n384 × 384\n```\n\nbecomes:\n\n```text\n192 × 192\n```\n\nThis is consistent with your density-map output resolution.\n\n## Feature-map sizes\n\nStarting with:\n\n```text\n768 × 768\n```\n\nEach column has two pooling layers.\n\nTherefore:\n\n```text\n768\n ↓ pool\n384\n ↓ pool\n192\n```\n\nSo every column eventually produces:\n\n```text\n192 × 192\n```\n\nThis is very important because the four branches need matching spatial dimensions before concatenation.\n\n## Channel dimensions\n\nAt the end:\n\n1. **Column 1:** 64 channels\n2. **Column 2:** 64 channels\n3. **Column 3:** 80 channels\n4. **Column 4:** 96 channels\n\nTherefore:\n\n$$\n64+64+80+96=304\n$$\n\nSo the combined tensor contains:\n\n```text\n304 channels\n```\n\n## Concatenation\n\nThe forward function:\n\n```python\nx1 = self.column1(x)\nx2 = self.column2(x)\nx3 = self.column3(x)\nx4 = self.column4(x)\n\nx_cat = torch.cat((x1,x2,x3,x4),dim=1)\n```\n\nConcatenates along the channel dimension.\n\nSo:\n\n```text\nColumn 1 → [B,64,192,192]\nColumn 2 → [B,64,192,192]\nColumn 3 → [B,80,192,192]\nColumn 4 → [B,96,192,192]\n```\n\nbecomes:\n\n```text\n[B,304,192,192]\n```\n\n## Fusion layer\n\nThe fusion layer is:\n\n```python\nnn.Conv2d(304,64,kernel_size=1)\n```\n\nWhy a 1×1 convolution?\n\nBecause it combines information across channels.\n\nYou can think of it as:\n\n```text\n304 feature channels\n        ↓\nlearn how to combine them\n        ↓\n64 feature channels\n```\n\nwithout changing:\n\n```text\n192 × 192\n```\n\nspatial dimensions.\n\n## Second fusion convolution\n\nThen:\n\n```python\nnn.Conv2d(64,1,kernel_size=1)\n```\n\nreduces:\n\n```text\n64 channels\n```\n\nto:\n\n```text\n1 channel\n```\n\nThat one channel is:\n\n> the predicted density map.\n\n## Why ReLU at the output?\n\nThe final layer is:\n\n```python\nnn.ReLU()\n```\n\nDensity values should normally be non-negative.\n\nYou don't want:\n\n```text\n-0.8 people density\n```\n\nSo ReLU ensures:\n\n$$\nD(x,y)\\ge0\n$$\n\n\n## Complete model architecture\n\nYour model can therefore be represented as:\n\n```text\n                       INPUT\n                    3×768×768\n                         │\n          ┌──────────────┼──────────────┐\n          │              │              │\n          ▼              ▼              ▼\n      Column 1       Column 2       Column 3       Column 4\n      11×11          9×9            7×7            5×5\n        ↓              ↓              ↓              ↓\n      9×9            7×7            5×5            3×3\n        ↓              ↓              ↓              ↓\n      7×7            5×5            3×3            3×3\n        │              │              │              │\n       64             64             80             96\n        └──────────────┴──────────────┴──────────────┘\n                              │\n                       Concatenate\n                              │\n                         304 channels\n                              │\n                           1×1 Conv\n                              │\n                          64 channels\n                              │\n                           ReLU\n                              │\n                           1×1 Conv\n                              │\n                           1 channel\n                              │\n                           ReLU\n                              │\n                    Predicted Density Map\n                         192×192\n```","metadata":{}},{"cell_type":"code","source":"model = (FourColumnMCNN().to(DEVICE))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:30.733624Z","iopub.execute_input":"2026-09-20T19:32:30.734018Z","iopub.status.idle":"2026-09-20T19:32:31.142332Z","shell.execute_reply.started":"2026-09-20T19:32:30.733983Z","shell.execute_reply":"2026-09-20T19:32:31.141441Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"model","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:31.146932Z","iopub.execute_input":"2026-09-20T19:32:31.147498Z","iopub.status.idle":"2026-09-20T19:32:31.155634Z","shell.execute_reply.started":"2026-09-20T19:32:31.147462Z","shell.execute_reply":"2026-09-20T19:32:31.154794Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import torch\nimport torch.nn as nn\n\n# Defines a custom loss function class\nclass CombinedLoss(nn.Module):            \n    # Initializes the loss weights\n    def __init__(self, weight_dmap=0.9, weight_sum_gt=0.1):  \n        # Initializes the parent nn.Module class\n        super(CombinedLoss, self).__init__()                 \n\n        # Gives 90% importance to density-map loss\n        self.weight_dmap = weight_dmap      \n        # Gives 10% importance to total-count loss\n        self.weight_sum_gt = weight_sum_gt  \n\n        # Creates MSE loss for pixel-wise density-map comparison\n        self.img_loss = nn.MSELoss()        \n        # Creates MAE/L1 loss for total-count comparison\n        self.gt_loss_mae = nn.L1Loss()      \n\n    # Defines how the combined loss is calculated\n    def forward(self, predications, density_maps, gt_counts):\n        # Converts ground-truth counts to floating-point values\n        gt_counts = gt_counts.float()                       \n        \n        # Calculates pixel-wise MSE between predicted and GT density maps\n        img_loss = self.img_loss(predications, density_maps)        \n\n        # Sums all pixels to obtain predicted object counts\n        pred_counts = torch.squeeze(predications.sum(dim=(2,3)))\n\n        # Calculates MAE between predicted and true counts\n        gt_loss_mae = self.gt_loss_mae(pred_counts, gt_counts)  \n\n        # Combines both losses using their weights\n        combined_loss = self.weight_dmap * img_loss + self.weight_sum_gt * gt_loss_mae  \n\n        return combined_loss, gt_loss_mae","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:31.156782Z","iopub.execute_input":"2026-09-20T19:32:31.157174Z","iopub.status.idle":"2026-09-20T19:32:31.172226Z","shell.execute_reply.started":"2026-09-20T19:32:31.15715Z","shell.execute_reply":"2026-09-20T19:32:31.171101Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# CombinedLoss class\n\nThis creates a **custom loss function**. Instead of using only one objective, i train the model using **two objectives**:\n\n1. Make the predicted density map look like the ground truth density map.\n2. Make the total predicted count close to the actual number of people.\n\nThis implementation uses:\n\n```python\nweight_dmap=0.9\nweight_sum_gt=0.1\n```\n\nSo:\n\n$$\nL = 0.9L_{density} + 0.1L_{count}\n$$\n\nThe density map objective gets 90% importance, while the count objective gets 10%. \n\n## Why two losses?\n\nThis is very important.\n\nSuppose the actual density map is:\n\n```text\nGT:\n\n0 0 1 0 0\n0 2 3 2 0\n0 1 2 1 0\n```\n\nThe model could produce:\n\n```text\nPrediction:\n\n0 1 1 1 0\n1 1 2 1 1\n0 1 1 1 0\n```\n\nThe spatial distribution may be wrong even if the total count is approximately correct.\n\nConversely, the model could produce a density map with excellent spatial similarity but a slightly incorrect total.\n\nTherefore, you have two requirements:\n\n1. **Requirement 1:** Predict **where** people are.\n2. **Requirement 2:** Predict **how many** people there are.\n\nThe two losses address those two requirements.\n\n## MSE density map loss\n\nI define:\n\n```python\nself.img_loss = nn.MSELoss()\n```\n\nMSE means: **Mean Squared Error**\n\nMathematically:\n\n$$\nL_{MSE}\n=\n\\frac{1}{N}\n\\sum_i\n(\\hat{D}_i-D_i)^2\n$$\n\nwhere:\n\n* $D_i$ = ground truth density\n* $\\hat D_i$ = predicted density\n\nSo every density map pixel contributes to the loss.\n\nIf the model predicts:\n\n```text\nGT = 2\nPrediction = 2\n```\n\nerror:\n\n$$\n(2-2)^2=0\n$$\n\nBut if:\n\n```text\nGT = 2\nPrediction = 5\n```\n\nthen:\n\n$$\n(5-2)^2=9\n$$\n\nSo large density errors are penalized more strongly.\n\n## Count loss\n\nI define:\n\n```python\nself.gt_loss_mae = nn.L1Loss()\n```\n\nL1 loss is equivalent to **Mean Absolute Error**.\n\n$$\nMAE =\n\\frac{1}{N}\n\\sum_i |\\hat C_i-C_i|\n$$\n\nFor example:\n\n```text\nActual = 100\nPredicted = 108\n```\n\nthen:\n\n$$\n|108-100|=8\n$$\n\nSo count error is 8 people.\n\n## Forward pass of the loss\n\nMy function is:\n\n```python\ndef forward(self, predications, batch_dmap, batch_gts):\n```\n\nThere are three inputs.\n\n1. `predications`\n\nThis is actually the predicted density map from the model.\n\nDespite the name `predications`, it isn't a conventional classification prediction tensor here.\n\nIt is:\n\n```text\nPredicted density map\n```\n2. `density_maps`: Ground truth density maps.\n3. `gt_counts`: Ground truth person counts.\n\n![Combined Loss](https://raw.githubusercontent.com/masum184e/spl_03/main/images/combinedloss.png)\n\n### Converting ground-truth counts\n\n```python\nbatch_gts = batch_gts.float()\n```\n\nThe model works with floating point tensors.\n\nFor example:\n\n| Before | After |\n| --- | --- |\n| `8` | `8.0` |\n| `15` | `15.0` |\n| `23` | `23.0` |\n\n### Density map loss\n\n```python\nimg_loss = self.img_loss(predications, density_maps)\n```\n\nThis compares:\n\n```text\nPredicted density map\n        VS\nGround-truth density map\n```\n\nusing MSE.\n\n### Obtaining predicted count\n\nThis is one of the most important lines:\n\n```python\npred_counts = torch.squeeze(predications.sum(dim=(2,3)))\n```\n- `torch.squeeze()` removes dimensions of size 1 from a tensor.\n\n```python\nx = torch.tensor([[[8, 15, 23]]])\n\nprint(x.shape)\n# torch.Size([1, 1, 3])\n\ny = torch.squeeze(x)\n\nprint(y)\n# tensor([ 8, 15, 23])\n\nprint(y.shape)\n# torch.Size([3])\n\n```\nLet's understand the tensor dimensions.\n\nSuppose the output is:\n\n```text\n[B, 1, H, W]\n```\n\nwhere:\n\n* B = batch size\n* 1 = density-map channel\n* H = height\n* W = width\n\nFor example:\n\n```text\n[8, 1, 192, 192]\n```\n\nThen:\n\n```python\npredications.sum(dim=(2,3))\n```\n\nmeans:\n\n> Sum across height and width.\n\nSo:\n\n```text\ndensity map\n     ↓\nsum every pixel\n     ↓\none number\n```\n\nFor one image:\n\n```text\ndensity map\n       ↓\n     SUM\n       ↓\n  125.7\n```\n\nThe predicted crowd count is therefore:\n\n$$\n\\hat C = \\sum_{x,y}\\hat D(x,y)\n$$\n\n### Count MAE\n\nThen:\n\n```python\ngt_loss_mae = self.gt_loss_mae(pred_counts, gt_counts)\n```\n\nThe predicted counts are compared against the true counts.\n\nFor example:\n\n```text\nActual counts:\n[100, 80, 120]\n\nPredicted:\n[103, 76, 117]\n```\n\nAbsolute errors:\n\n```text\n3\n4\n3\n```\n\nMean:\n\n$$\nMAE=\\frac{3+4+3}{3}=3.33\n$$\n\n### Combined loss\n\nFinally:\n\n```python\ncombined_loss = (self.weight_dmap * img_loss + self.weight_sum_gt * gt_loss_mae)\n```\n\nTherefore:\n\n$$\nL =\n0.9L_{MSE}\n+\n0.1L_{MAE}\n$$\n\nThis is what the optimizer ultimately tries to minimize.","metadata":{}},{"cell_type":"code","source":"import torch.optim as optim\n\ncriterion = CombinedLoss(weight_dmap=0.9, weight_sum_gt=0.1)\noptimizer = optim.Adam(model.parameters(), lr=1e-4)\nscheduler = optim.lr_scheduler.StepLR(optimizer, step_size=10, gamma=0.1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:31.174878Z","iopub.execute_input":"2026-09-20T19:32:31.175325Z","iopub.status.idle":"2026-09-20T19:32:31.193628Z","shell.execute_reply.started":"2026-09-20T19:32:31.175283Z","shell.execute_reply":"2026-09-20T19:32:31.192801Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"* `criterion(...)` calls `forward()` because criterion is an `nn.Module`, It has special behaviour.\n\n# Optimizer\n\nAdam is the optimization algorithm.\n\nIts job is to update model parameters.\n\nConceptually:\n\n```text\nCurrent weights\n      ↓\nCalculate loss\n      ↓\nCalculate gradients\n      ↓\n    Adam\n      ↓\nUpdated weights\n```\n\n## Adam vs Other Optimizers\n\nA useful way to understand Adam is to compare it with the major alternatives.\n\n| Optimizer | Main Idea | Strength |\n|---|---|---|\n| **SGD** | Follow the current gradient | Simple, often excellent with good tuning |\n| **Momentum SGD** | Gradient + accumulated direction | Smoother and faster movement |\n| **AdaGrad** | Adapt learning rate using past squared gradients | Good for sparse features |\n| **RMSProp** | Adapt learning rate using recent squared gradients | Handles changing gradient scales |\n| **Adam** | Momentum + adaptive learning rates | Good general-purpose default |\n\n> **Adam essentially combines the important ideas of Momentum + RMSProp.**\n\n\n# Learning rate\n\nThe learning rate controls how large each update is.\n\nToo large:\n\n```text\ntraining may become unstable\n```\n\nToo small:\n\n```text\ntraining may be extremely slow\n```\n\n# Learning rate scheduler\n\nThis means every 10 epochs:\n\n$$\nLR_{new}=0.1\\times LR_{old}\n$$\n\nSo:\n\n```text\nEpoch 1–10:\n1e-4\n\nEpoch 11–20:\n1e-5\n\nEpoch 21–30:\n1e-6\n\nEpoch 31–40:\n1e-7\n```\n\nand so on.\n\nThe actual code calls:\n\n```python\nscheduler.step()\n```\n\nafter each epoch. ","metadata":{}},{"cell_type":"code","source":"NUM_EPOCHS = 100\n\nPATIENCE = 30\nOUTPUT_DIR = Path(\"/kaggle/working/mcnn_results\")\n\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\nBEST_MODEL_PATH = (OUTPUT_DIR / \"mcnn_best.pth\")\nLATEST_MODEL_PATH = (OUTPUT_DIR / \"mcnn_latest.pth\")\nHISTORY_CSV_PATH = (OUTPUT_DIR / \"mcnn_training_history.csv\")\n\nprint(\"\\nOutput directory:\", OUTPUT_DIR)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:31.19476Z","iopub.execute_input":"2026-09-20T19:32:31.195001Z","iopub.status.idle":"2026-09-20T19:32:31.208565Z","shell.execute_reply.started":"2026-09-20T19:32:31.194969Z","shell.execute_reply":"2026-09-20T19:32:31.207844Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Training configuration\n\nThe code specifies:\n\n```python\nNUM_EPOCHS = 100\n```\n\nMaximum:\n\n```text\n100 epochs\n```\n\nBut it doesn't necessarily run all 100.\n\nBecause:\n\n```python\nPATIENCE = 30\n```\n\nis used for early stopping.\n\n> Patience is the number of epochs you wait for the validation performance to improve before stopping training.\n\n## Epoch\n\nOne epoch means:\n\n> The model has processed the entire training dataset once.\n\nFor example:\n\n```text\n360 training images\nbatch size = 8\n```\n\napproximately:\n\n$$\n360/8=45\n$$\n\nbatches per epoch.\n\n## Best model\n\n`mcnn_best.pth` stores the model state corresponding to the best validation loss.\n\nThis is important because the last epoch isn't necessarily the best epoch.\n\nFor example:\n\n```text\nEpoch 10 → val loss = 0.50\nEpoch 20 → val loss = 0.35\nEpoch 30 → val loss = 0.28\nEpoch 40 → val loss = 0.31\n```\n\nBest:\n\n```text\nEpoch 30\n```\n\nSo you want epoch 30's model, not epoch 40's.\n\n## Latest checkpoint\n\n`mcnn_latest.pth` stores the most recent model state.\n\nThis is useful if training gets interrupted.\n\nYou can potentially resume from the latest checkpoint.\n\n## Training history\n\nThe CSV contains:\n\n```text\nepoch\ntrain_loss\nval_loss\ntrain_mae\nval_mae\nis_best_epoch\n```\n\nThis allows you to plot:\n\n```text\nLoss vs Epoch\nMAE vs Epoch\n```\n\nand identify:\n\n* convergence\n* overfitting\n* underfitting\n* best epoch","metadata":{}},{"cell_type":"code","source":"train_losses = []\nval_losses = []\n\ntrain_mae_losses = []\nval_mae_losses = []\n\nbest_val_loss = float(\"inf\")\nbest_epoch = -1\nepochs_without_improvement = 0","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T19:32:31.209402Z","iopub.execute_input":"2026-09-20T19:32:31.209642Z","iopub.status.idle":"2026-09-20T19:32:31.227804Z","shell.execute_reply.started":"2026-09-20T19:32:31.209622Z","shell.execute_reply":"2026-09-20T19:32:31.22698Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from tqdm.auto import tqdm\nimport pandas as pd\n\nfor epoch in range(NUM_EPOCHS):\n\n    print(\"=\" * 60)\n    print(f\"Epoch {epoch + 1}/{NUM_EPOCHS}\")\n    print(\"=\" * 60)\n\n    # TRAIN\n    model.train()\n\n    train_loss_total = 0.0\n    train_mae_total = 0.0\n\n    progress_bar = tqdm(train_loader, desc=\"Training\", leave=False)\n\n    for images, density_maps, gt_counts in progress_bar:\n        \n        images = images.to(DEVICE, non_blocking=True)\n        density_maps = density_maps.to(DEVICE, non_blocking=True)\n        gt_counts = gt_counts.to(DEVICE, non_blocking=True)\n\n        # Forward + Backward\n        optimizer.zero_grad(set_to_none=True)\n        predictions = model(images)\n        loss, count_mae = criterion(predictions, density_maps, gt_counts)\n\n        loss.backward()\n\n        # Gradient Clipping\n        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)\n        optimizer.step()\n\n        # Accumulate Metrics\n        batch_size_current = images.size(0)\n        train_loss_total += (loss.item() * batch_size_current)\n        train_mae_total += (count_mae.item() * batch_size_current)\n\n        progress_bar.set_postfix(loss=f\"{loss.item():.4f}\", mae=f\"{count_mae.item():.2f}\")\n\n    # Average Training Metrics\n    train_loss = (train_loss_total / len(train_loader.dataset))\n    train_mae = (train_mae_total / len(train_loader.dataset))\n\n    # VALIDATION\n    model.eval()\n\n    val_loss_total = 0.0\n    val_mae_total = 0.0\n\n    with torch.inference_mode():\n        progress_bar = tqdm(val_loader, desc=\"Validation\", leave=False)\n\n        for images, density_maps, gt_counts in progress_bar:\n\n            images = images.to(DEVICE, non_blocking=True)\n\n            density_maps = density_maps.to(DEVICE, non_blocking=True)\n            gt_counts = gt_counts.to(DEVICE, non_blocking=True)\n\n            predictions = model(images)\n            loss, count_mae = criterion(predictions, density_maps, gt_counts)\n\n            batch_size_current = images.size(0)\n\n            val_loss_total += (loss.item() * batch_size_current)\n            val_mae_total += (count_mae.item() * batch_size_current)\n\n    # Average Validation Metrics\n    val_loss = (val_loss_total / len(val_loader.dataset))\n    val_mae = (val_mae_total / len(val_loader.dataset))\n\n 