t as plt\n","\n","fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n","\n","# Mark best epoch\n","best_rows = history_df[history_df[\"is_best_epoch\"]]\n","\n","# LOSS GRAPH\n","axes[0].plot(\n","    history_df[\"epoch\"],\n","    history_df[\"train_loss\"],\n","    label=\"Training Loss\",\n","    linewidth=2\n",")\n","\n","axes[0].plot(\n","    history_df[\"epoch\"],\n","    history_df[\"val_loss\"],\n","    label=\"Validation Loss\",\n","    linewidth=2\n",")\n","\n","if not best_rows.empty:\n","\n","    best_epoch_plot = best_rows.iloc[0][\"epoch\"]\n","\n","    axes[0].axvline(\n","        best_epoch_plot,\n","        color=\"red\",\n","        linestyle=\"--\",\n","        linewidth=1.5,\n","        alpha=0.7,\n","        label=f\"Best Epoch ({int(best_epoch_plot)})\"\n","    )\n","\n","axes[0].set_title(\"Training and Validation Loss\", fontsize=13, fontweight=\"bold\")\n","axes[0].set_xlabel(\"Epoch\")\n","axes[0].set_ylabel(\"Loss\")\n","axes[0].legend()\n","axes[0].grid(True, alpha=0.3)\n","\n","# MAE GRAPH\n","axes[1].plot(\n","    history_df[\"epoch\"],\n","    history_df[\"train_mae\"],\n","    label=\"Training MAE\",\n","    linewidth=2\n",")\n","\n","axes[1].plot(\n","    history_df[\"epoch\"],\n","    history_df[\"val_mae\"],\n","    label=\"Validation MAE\",\n","    linewidth=2\n",")\n","\n","# Mark best epoch\n","if not best_rows.empty:\n","    axes[1].axvline(\n","        best_epoch_plot,\n","        color=\"red\",\n","        linestyle=\"--\",\n","        linewidth=1.5,\n","        alpha=0.7,\n","        label=f\"Best Epoch ({int(best_epoch_plot)})\"\n","    )\n","\n","axes[1].set_title(\"Training and Validation MAE\", fontsize=13, fontweight=\"bold\")\n","axes[1].set_xlabel(\"Epoch\")\n","axes[1].set_ylabel(\"MAE\")\n","axes[1].legend()\n","axes[1].grid(True, alpha=0.3)\n","\n","# FIGURE\n","plt.suptitle(\"FourColumnMCNN Training Performance\", fontsize=16, fontweight=\"bold\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"4392a6a4","metadata":{"papermill":{"duration":0.02935,"end_time":"2026-09-26T08:06:22.914965+00:00","exception":false,"start_time":"2026-09-26T08:06:22.885615+00:00","status":"completed"},"tags":[]},"source":["# Key Findings\n","\n","## Why MCNN is suitable for crowd counting\n","\n","Crowds have a scale problem.\n","\n","Consider:\n","\n","```text\n","Camera near people\n","\n","████████████\n","████████████\n","```\n","\n","versus:\n","\n","```text\n","Camera far away\n","\n","••••••••••••••••\n","```\n","\n","People can have drastically different apparent sizes.\n","\n","Your network therefore has:\n","\n","```text\n","Large kernel branch\n","        +\n","medium kernel branches\n","        +\n","small kernel branch\n","```\n","\n","This provides multi-scale feature extraction.\n","\n","## The most important mathematical formulation\n","\n","Your model can be described mathematically as follows.\n","\n","Given an input image $I$:\n","\n","$$\n","\\hat D=f_\\theta(I)\n","$$\n","\n","where:\n","\n","$$\n","\\hat D\\in\\mathbb{R}^{H\\times W}\n","$$\n","\n","is the predicted density map.\n","\n","The predicted count is:\n","\n","$$\n","\\hat C=\\sum_{x=1}^{H}\\sum_{y=1}^{W}\\hat D(x,y)\n","$$\n","\n","The density-map loss is:\n","\n","$$\n","L_D=\n","\\frac{1}{HW}\n","\\sum_{x,y}\n","(\\hat D(x,y)-D(x,y))^2\n","$$\n","\n","The counting loss is:\n","\n","$$\n","L_C=|\\hat C-C|\n","$$\n","\n","For a batch, L1Loss averages these absolute differences.\n","\n","The final objective is:\n","\n","$$\n","\\boxed{\n","L=0.9L_D+0.1L_C\n","}\n","$$\n","\n","That equation summarizes one of the most important parts of your implementation.\n","\n","## Full end-to-end example\n","\n","Suppose an image contains:\n","\n","```text\n","Actual people = 50\n","```\n","\n","The annotation file contains:\n","\n","```text\n","50 head points\n","```\n","\n","### Step 1\n","\n","Resize image:\n","\n","```text\n","original\n","   ↓\n","768×768\n","```\n","\n","### Step 2\n","\n","Transform 50 points to the resized coordinate system.\n","\n","### Step 3\n","\n","Create:\n","\n","```text\n","50 impulses\n","```\n","\n","### Step 4\n","\n","Apply Gaussian filtering.\n","\n","### Step 5\n","\n","Normalize:\n","\n","```text\n","sum(density map) = 50\n","```\n","\n","### Step 6\n","\n","Downsample:\n","\n","```text\n","768×768\n"," ↓\n","192×192\n","```\n","\n","while compensating density values.\n","\n","### Step 7\n","\n","Feed image into MCNN.\n","\n","### Step 8\n","\n","Four branches extract features:\n","\n","```text\n","large scale\n","large-medium scale\n","medium scale\n","small scale\n","```\n","\n","### Step 9\n","\n","Features are concatenated:\n","\n","```text\n","64 + 64 + 80 + 96 = 304 channels\n","```\n","\n","### Step 10\n","\n","Fusion produces:\n","\n","```text\n","1-channel density map\n","```\n","\n","### Step 11\n","\n","Suppose model predicts:\n","\n","```text\n","sum(predicted density) = 47.8\n","```\n","\n","Then:\n","\n","```text\n","Predicted count = 47.8\n","Actual count = 50\n","```\n","\n","Count error:\n","\n","$$\n","|47.8-50|=2.2\n","$$\n","\n","### Step 12\n","\n","The density-map MSE is also calculated.\n","\n","### Step 13\n","\n","Final loss:\n","\n","$$\n","0.9(MSE)+0.1(2.2)\n","$$\n","\n","### Step 14\n","\n","Backpropagation calculates gradients.\n","\n","### Step 15\n","\n","Adam updates the model.\n","\n","And this repeats thousands of times.\n","\n","## What each major component is responsible for\n","\n","| Component                     | Purpose                                        |\n","| ----------------------------- | ---------------------------------------------- |\n","| `EnhancedShanghaiTechDataset` | Loads/prepares training samples                |\n","| `generate_density_map()`      | Converts point annotations into density maps   |\n","| `CombinedLoss`                | Combines spatial and counting objectives       |\n","| `FourColumnMCNN`              | Predicts density maps                          |\n","| `Adam`                        | Updates model weights                          |\n","| `StepLR`                      | Reduces learning rate                          |\n","| `DataLoader`                  | Creates batches                                |\n","| `validation`                  | Measures generalization                        |\n","| `best checkpoint`             | Saves best-performing model                    |\n","| `latest checkpoint`           | Saves latest training state                    |\n","| `early stopping`              | Stops training after prolonged non-improvement |\n","\n"]},{"cell_type":"code","execution_count":21,"id":"b5633fd3","metadata":{"execution":{"iopub.execute_input":"2026-09-26T08:06:22.973987Z","iopub.status.busy":"2026-09-26T08:06:22.973664Z","iopub.status.idle":"2026-09-26T08:06:41.892414Z","shell.execute_reply":"2026-09-26T08:06:41.891331Z"},"papermill":{"duration":18.950036,"end_time":"2026-09-26T08:06:41.894291+00:00","exception":false,"start_time":"2026-09-26T08:06:22.944255+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"0e984a6cbfff4d17bed8371faa5e002d","version_major":2,"version_minor":0},"text/plain":["Testing:   0%|          | 0/40 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"}],"source":["test_loss_total = 0.0\n","test_mae_total = 0.0\n","\n","with torch.inference_mode():\n","    progress_bar = tqdm(test_loader, desc=\"Testing\", leave=True)\n","\n","    for images, density_maps, gt_counts in progress_bar:\n","\n","        images = images.to(DEVICE, non_blocking=True)\n","        density_maps = density_maps.to(DEVICE, non_blocking=True)\n","        gt_counts = gt_counts.to(DEVICE, non_blocking=True)\n","        \n","        # Prediction\n","        predictions = model(images)\n","        loss, count_mae = criterion(predictions, density_maps, gt_counts)\n","\n","        # Accumulate Metrics\n","        batch_size_current = i